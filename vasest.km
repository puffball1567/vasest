}

export function expectSlice<T>(actual: T[]): SliceExpectation<T> {
  return new SliceExpectation<T>(actual);
}

function checkSliceElement<T>(actual: T[], index: int, expected: T, negated: boolean, location: TestLocation): void {
  if (index < 0) {
    throw new FailureError(errors.New("slice element index must not be negative"), location);
  }
  if (index >= len(actual)) {
    if (negated) { return; }
    throw new FailureError(fmt.Errorf("expected slice element %d to equal %#v, index is missing", index, diagnosticArgument(expected)), location);
  }
  const value = actual[index];
  if (reflect.DeepEqual(value, expected) == negated) {
    let qualifier = "";
    if (negated) { qualifier = "not "; }
    throw new FailureError(fmt.Errorf("expected slice element %d %sto equal %#v, got %#v", index, qualifier, diagnosticArgument(expected), diagnosticArgument(value)), location);
  }
}

function checkSliceElementPredicate<T>(actual: T[], index: int, predicate: (value: T) => boolean, negated: boolean, location: TestLocation): void {
  if (index < 0) {
    throw new FailureError(errors.New("slice element index must not be negative"), location);
  }
  if (predicate == nil) {
    throw new FailureError(errors.New("toHaveElementSatisfying predicate must not be nil"), location);
  }
  if (index >= len(actual)) {
    if (negated) { return; }
    throw new FailureError(fmt.Errorf("expected slice element %d to satisfy predicate, index is missing", index), location);
  }
  // Read once before invoking user code; keep the selected native value and
  // propagate callback control flow without wrapping or retrying it.
  const value = actual[index];
  if (predicate(value) == negated) {
    let qualifier = "";
    if (negated) { qualifier = "not "; }
    throw new FailureError(fmt.Errorf("expected slice element %d %sto satisfy predicate", index, qualifier), location);
  }
}

function sliceBoundaryMatches<T>(actual: T[], expected: T[], fromStart: boolean): boolean {
  if (len(expected) > len(actual)) {
    return false;
  }
  let offset = 0;
  if (!fromStart) {
    offset = len(actual) - len(expected);
  }
  for (let index = 0; index < len(expected); index++) {
    if (!reflect.DeepEqual(actual[offset + index], expected[index])) {
      return false;
    }
  }
  return true;
}

function checkSliceBoundary<T>(actual: T[], expected: T[], fromStart: boolean, negated: boolean, location: TestLocation): void {
  if (sliceBoundaryMatches<T>(actual, expected, fromStart) == negated) {
    let qualifier = "";
    if (negated) { qualifier = "not "; }
    let relation = "start with";
    if (!fromStart) { relation = "end with"; }
    throw new FailureError(fmt.Errorf("expected slice %sto %s %#v, got %#v", qualifier, relation, diagnosticArgument(expected), diagnosticArgument(actual)), location);
  }
}

function sliceContainsSequence<T>(actual: T[], expected: T[]): boolean {
  if (len(expected) > len(actual)) {
    return false;
  }
  for (let offset = 0; offset <= len(actual) - len(expected); offset++) {
    if (sliceBoundaryMatches<T>(actual[offset:len(actual)], expected, true)) {
      return true;
    }
  }
  return false;
}

function checkSliceSequence<T>(actual: T[], expected: T[], negated: boolean, location: TestLocation): void {
  if (sliceContainsSequence<T>(actual, expected) == negated) {
    let qualifier = "";
    if (negated) { qualifier = "not "; }
    throw new FailureError(fmt.Errorf("expected slice %sto contain contiguous sequence %#v, got %#v", qualifier, diagnosticArgument(expected), diagnosticArgument(actual)), location);
  }
}

function sliceContainsInOrder<T>(actual: T[], expected: T[]): boolean {
  if (len(expected) == 0) {
    return true;
  }
  if (len(expected) > len(actual)) {
    return false;
  }
  let matched = 0;
  for (const value of actual) {
    if (reflect.DeepEqual(value, expected[matched])) {
      matched++;
      if (matched == len(expected)) {
        return true;
      }
    }
  }
  return false;
}

function checkSliceInOrder<T>(actual: T[], expected: T[], negated: boolean, location: TestLocation): void {
  if (sliceContainsInOrder<T>(actual, expected) == negated) {
    let qualifier = "";
    if (negated) { qualifier = "not "; }
    throw new FailureError(fmt.Errorf("expected slice %sto contain %#v in order, got %#v", qualifier, diagnosticArgument(expected), diagnosticArgument(actual)), location);
  }
}

function sliceEqualUnordered<T>(actual: T[], expected: T[]): boolean {
  if (len(actual) != len(expected)) {
    return false;
  }
  if (actual == nil || expected == nil) {
    return actual == nil && expected == nil;
  }
  return sliceContainsAll<T>(actual, expected);
}

function sliceContainsAll<T>(actual: T[], expected: T[]): boolean {
  if (len(expected) == 0) {
    return true;
  }
  if (len(expected) > len(actual)) {
    return false;
  }
  let matched: boolean[] = [];
  for (const value of actual) {
    matched = append(matched, false);
  }
  for (const value of expected) {
    let found = false;
    let index = 0;
    for (const candidate of actual) {
      if (!matched[index] && reflect.DeepEqual(value, candidate)) {
        matched[index] = true;
        found = true;
        break;
      }
      index++;
    }
    if (!found) {
      return false;
    }
  }
  return true;
}

function checkSliceContainsAll<T>(actual: T[], expected: T[], negated: boolean, location: TestLocation): void {
  if (sliceContainsAll<T>(actual, expected) == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected slice %sto contain all %#v including duplicate counts, got %#v", qualifier, diagnosticArgument(expected), diagnosticArgument(actual)), location);
  }
}

function checkSliceEqualUnordered<T>(actual: T[], expected: T[], negated: boolean, location: TestLocation): void {
  if (sliceEqualUnordered<T>(actual, expected) == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected slice %sto equal %#v ignoring order, got %#v", qualifier, diagnosticArgument(expected), diagnosticArgument(actual)), location);
  }
}

function checkSlicePredicate<T>(actual: T[], predicate: (value: T) => boolean, all: boolean, negated: boolean, location: TestLocation): void {
  let matcher = "toSatisfyAny";
  let quantifier = "any";
  if (all) {
    matcher = "toSatisfyAll";
    quantifier = "every";
  }
  if (predicate == nil) {
    throw new FailureError(fmt.Errorf("%s predicate must not be nil", matcher), location);
  }
  let matches = all;
  let checked = 0;
  // Preserve native element values and propagate callback control flow unchanged.
  for (const value of actual) {
    checked++;
    if (predicate(value) != all) {
      matches = !all;
      break;
    }
  }
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected slice %sto satisfy predicate for %s element, checked %d of %d element(s)", qualifier, quantifier, checked, len(actual)), location);
  }
}

function checkSliceIndexedPredicate<T>(actual: T[], predicate: (value: T, index: int) => boolean, all: boolean, negated: boolean, location: TestLocation): void {
  let matcher = "toSatisfyAnyIndexed";
  let quantifier = "any";
  if (all) {
    matcher = "toSatisfyAllIndexed";
    quantifier = "every";
  }
  if (predicate == nil) {
    throw new FailureError(fmt.Errorf("%s predicate must not be nil", matcher), location);
  }
  let matches = all;
  let checked = 0;
  for (let index = 0; index < len(actual); index++) {
    checked++;
    if (predicate(actual[index], index) != all) {
      matches = !all;
      break;
    }
  }
  if (matches == negated) {
    let qualifier = "";
    if (negated) { qualifier = "not "; }
    throw new FailureError(fmt.Errorf("expected slice %sto satisfy indexed predicate for %s element, checked %d of %d element(s)", qualifier, quantifier, checked, len(actual)), location);
  }
}

export class NegatedMapExpectation<K extends comparable, V> {
  private actual: Map<K, V>;

  constructor(actual: Map<K, V>) {
    this.actual = actual;
  }

  public function toHaveKey(key: K): void {
    const location = callerLocation();
    try {
      checkMapKey<K, V>(this.actual, key, true);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toHaveEntry(key: K, expected: V): void {
    const location = callerLocation();
    try {
      checkMapEntry<K, V>(this.actual, key, expected, true);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toHaveEntrySatisfying(key: K, predicate: (value: V) => boolean): void {
    checkMapEntryPredicate<K, V>(this.actual, key, predicate, true, callerLocation());
  }

  public function toHaveEntries(expected: Map<K, V>): void {
    checkMapEntries<K, V>(this.actual, expected, true, callerLocation());
  }

  public function toSatisfyAny(predicate: (key: K, value: V) => boolean): void {
    checkMapPredicate<K, V>(this.actual, predicate, false, true, callerLocation());
  }

  public function toSatisfyAll(predicate: (key: K, value: V) => boolean): void {
    checkMapPredicate<K, V>(this.actual, predicate, true, true, callerLocation());
  }

  public function toHaveLength(expected: int): void {
    const location = callerLocation();
    try {
      checkLength(len(this.actual), expected, true);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }
}

export class MapExpectation<K extends comparable, V> {
  private actual: Map<K, V>;
  public not: NegatedMapExpectation<K, V>;

  constructor(actual: Map<K, V>) {
    this.actual = actual;
    this.not = new NegatedMapExpectation<K, V>(actual);
  }

  public function toHaveKey(key: K): void {
    const location = callerLocation();
    try {
      checkMapKey<K, V>(this.actual, key, false);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toHaveEntry(key: K, expected: V): void {
    const location = callerLocation();
    try {
      checkMapEntry<K, V>(this.actual, key, expected, false);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toHaveEntrySatisfying(key: K, predicate: (value: V) => boolean): void {
    checkMapEntryPredicate<K, V>(this.actual, key, predicate, false, callerLocation());
  }

  public function toHaveEntries(expected: Map<K, V>): void {
    checkMapEntries<K, V>(this.actual, expected, false, callerLocation());
  }

  public function toSatisfyAny(predicate: (key: K, value: V) => boolean): void {
    checkMapPredicate<K, V>(this.actual, predicate, false, false, callerLocation());
  }

  public function toSatisfyAll(predicate: (key: K, value: V) => boolean): void {
    checkMapPredicate<K, V>(this.actual, predicate, true, false, callerLocation());
  }

  public function toHaveLength(expected: int): void {
    const location = callerLocation();
    try {
      checkLength(len(this.actual), expected, false);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }
}

export function expectMap<K extends comparable, V>(actual: Map<K, V>): MapExpectation<K, V> {
  return new MapExpectation<K, V>(actual);
}

function checkMapKey<K extends comparable, V>(actual: Map<K, V>, key: K, negated: boolean): void {
  const [value, present] = actual[key];
  if (present == negated) {
    if (negated) {
      throw fmt.Errorf("expected map not to have key %#v", diagnosticArgument(key));
    }
    throw fmt.Errorf("expected map to have key %#v", diagnosticArgument(key));
  }
}

function checkMapEntry<K extends comparable, V>(actual: Map<K, V>, key: K, expected: V, negated: boolean): void {
  const [value, present] = actual[key];
  const matches = present && reflect.DeepEqual(value, expected);
  if (matches == negated) {
    if (negated) {
      throw fmt.Errorf("expected map not to have entry %#v: %#v", diagnosticArgument(key), diagnosticArgument(expected));
    }
    if (!present) {
      throw fmt.Errorf("expected map entry %#v: %#v, key is missing", diagnosticArgument(key), diagnosticArgument(expected));
    }
    throw fmt.Errorf("expected map entry %#v: %#v, got %#v", diagnosticArgument(key), diagnosticArgument(expected), diagnosticArgument(value));
  }
}

function checkMapEntries<K extends comparable, V>(actual: Map<K, V>, expected: Map<K, V>, negated: boolean, location: TestLocation): void {
  let matches = true;
  // Match each required entry using the same lookup and equality as toHaveEntry.
  // Do not shortcut aliased maps: NaN keys and values retain native behavior.
  for (const [key, required] of expected) {
    const [value, present] = actual[key];
    if (!present || !reflect.DeepEqual(value, required)) {
      matches = false;
      break;
    }
  }
  if (matches == negated) {
    let qualifier = "";
    if (negated) { qualifier = "not "; }
    throw new FailureError(fmt.Errorf("expected map %sto have entries %#v, got %#v", qualifier, diagnosticArgument(expected), diagnosticArgument(actual)), location);
  }
}

function checkMapEntryPredicate<K extends comparable, V>(actual: Map<K, V>, key: K, predicate: (value: V) => boolean, negated: boolean, location: TestLocation): void {
  if (predicate == nil) {
    throw new FailureError(errors.New("toHaveEntrySatisfying predicate must not be nil"), location);
  }
  const [value, present] = actual[key];
  if (!present) {
    if (negated) {
      return;
    }
    throw new FailureError(fmt.Errorf("expected map entry %#v to satisfy predicate, key is missing", diagnosticArgument(key)), location);
  }
  // Read once and preserve the selected native value and callback control flow.
  if (predicate(value) == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected map entry %#v not to satisfy predicate", diagnosticArgument(key)), location);
    }
    throw new FailureError(fmt.Errorf("expected map entry %#v to satisfy predicate", diagnosticArgument(key)), location);
  }
}

function checkMapPredicate<K extends comparable, V>(actual: Map<K, V>, predicate: (key: K, value: V) => boolean, all: boolean, negated: boolean, location: TestLocation): void {
  let matcher = "toSatisfyAny";
  let quantifier = "any";
  if (all) {
    matcher = "toSatisfyAll";
    quantifier = "every";
  }
  if (predicate == nil) {
    throw new FailureError(fmt.Errorf("%s predicate must not be nil", matcher), location);
  }
  let matches = all;
  let checked = 0;
  // Iterate native pairs directly: a second lookup would lose NaN-key values.
  for (const [key, value] of actual) {
    checked++;
    if (predicate(key, value) != all) {
      matches = !all;
      break;
    }
  }
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected map %sto satisfy predicate for %s entry, checked %d entry(s)", qualifier, quantifier, checked), location);
  }
}

function checkLength(actual: int, expected: int, negated: boolean): void {
  if (expected < 0) {
    throw errors.New("expected length must not be negative");
  }
  if ((actual == expected) == negated) {
    if (negated) {
      throw fmt.Errorf("did not expect length %d", expected);
    }
    throw fmt.Errorf("expected length %d, got %d", expected, actual);
  }
}

function checkSliceContains<T>(actual: T[], expected: T, negated: boolean): void {
  let found = false;
  for (const value of actual) {
    if (reflect.DeepEqual(value, expected)) {
      found = true;
      break;
    }
  }
  if (found == negated) {
    if (negated) {
      throw fmt.Errorf("expected slice %#v not to contain %#v", diagnosticArgument(actual), diagnosticArgument(expected));
    }
    throw fmt.Errorf("expected slice %#v to contain %#v", diagnosticArgument(actual), diagnosticArgument(expected));
  }
}

function errorTypeSatisfies<T>(actual: error, predicate: (value: T) => boolean, targetType: reflect.Type): boolean {
  // Every extraction gets a fresh destination, including custom As matches with nil values.
  const target = reflect.New(targetType);
  const selected = target.Interface() as! *T;
  return errors.As(actual, selected) && predicate(*selected);
}

function checkErrorTypePredicate<T>(actual: error, predicate: (value: T) => boolean, negated: boolean, location: TestLocation): void {
  if (predicate == nil) {
    throw new FailureError(errors.New("error type predicate must not be nil"), location);
  }
  let targetType: reflect.Type = nil;
  try {
    targetType = checkedErrorMatchType<T>("toMatchTypeSatisfying");
  } catch (err: error) {
    throw new FailureError(err, location);
  }
  // Native As and predicate control flow must retain their original identity/location.
  const matches = errorTypeSatisfies<T>(actual, predicate, targetType);
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected error %sto contain a value assignable to %s satisfying predicate (errors.As)", qualifier, targetType.String()), location);
  }
}

export class NegatedErrorExpectation {
  private actual: error;

  constructor(actual: error) {
    this.actual = actual;
  }

  public function toBeNil(): void {
    const location = callerLocation();
    try {
      expectError(this.actual);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toMatchCause(target: error): void {
    if (errors.Is(this.actual, target)) {
      throw assertionError(fmt.Errorf("expected error %v not to match %v (errors.Is)", this.actual, target));
    }
  }

  public function toMatchType<T>(): void {
    const location = callerLocation();
    try {
      const targetType = checkedErrorMatchType<T>("toMatchType");
      const target = reflect.New(targetType);
      if (errors.As(this.actual, target.Interface())) {
        throw fmt.Errorf("expected error %v not to contain a value assignable to %s (errors.As)", this.actual, targetType.String());
      }
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toMatchTypeSatisfying<T>(predicate: (value: T) => boolean): void {
    checkErrorTypePredicate<T>(this.actual, predicate, true, callerLocation());
  }
}

export class ErrorExpectation {
  private actual: error;
  public not: NegatedErrorExpectation;

  constructor(actual: error) {
    this.actual = actual;
    this.not = new NegatedErrorExpectation(actual);
  }

  public function toBeNil(): void {
    const location = callerLocation();
    try {
      expectNoError(this.actual);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toMatchCause(target: error): void {
    const location = callerLocation();
    try {
      expectErrorIs(this.actual, target);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toMatchType<T>(target: *T): void {
    const location = callerLocation();
    try {
      expectErrorAs<T>(this.actual, target);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toMatchTypeSatisfying<T>(predicate: (value: T) => boolean): void {
    checkErrorTypePredicate<T>(this.actual, predicate, false, callerLocation());
  }
}

export function expectErrorValue(actual: error): ErrorExpectation {
  return new ErrorExpectation(actual);
}

struct FunctionOutcome {
  public threw: boolean;
  public exception: error;
}

function invokeFunctionExpectation(body: () => void): FunctionOutcome {
  if (body == nil) {
    throw errors.New("function expectation body must not be nil");
  }
  try {
    body();
  } catch (err: error) {
    return FunctionOutcome { threw: true, exception: err };
  }
  return FunctionOutcome { threw: false, exception: nil };
}

function requireFunctionThrow(outcome: FunctionOutcome): error {
  if (!outcome.threw) {
    throw errors.New("expected function to throw an error");
  }
  return outcome.exception;
}

function functionThrowMessage(outcome: FunctionOutcome): string {
  if (outcome.exception == nil) {
    return "";
  }
  return outcome.exception.Error();
}

function validateThrowMessage(fragment: string): void {
  if (fragment == "") {
    throw errors.New("expected error message fragment must not be empty");
  }
}

function checkFunctionThrowPredicate(body: () => void, predicate: (exception: error) => boolean, negated: boolean, location: TestLocation): void {
  if (predicate == nil) {
    throw new FailureError(errors.New("function throw predicate must not be nil"), location);
  }
  if (body == nil) {
    throw new FailureError(errors.New("function expectation body must not be nil"), location);
  }
  const outcome = invokeFunctionExpectation(body);
  if (!outcome.threw) {
    if (!negated) {
      throw new FailureError(errors.New("expected function to throw an error"), location);
    }
    return;
  }
  // Only the body is captured as an outcome. Predicate control flow propagates.
  if (predicate(outcome.exception) == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected function %sto throw an error satisfying predicate", qualifier), location);
  }
}

function checkFunctionThrowTypePredicate<T>(body: () => void, predicate: (value: T) => boolean, negated: boolean, location: TestLocation): void {
  if (predicate == nil) {
    throw new FailureError(errors.New("function throw type predicate must not be nil"), location);
  }
  let targetType: reflect.Type = nil;
  try {
    targetType = checkedErrorMatchType<T>("toThrowTypeSatisfying");
  } catch (err: error) {
    throw new FailureError(err, location);
  }
  if (body == nil) {
    throw new FailureError(errors.New("function expectation body must not be nil"), location);
  }
  const outcome = invokeFunctionExpectation(body);
  if (!outcome.threw) {
    if (!negated) {
      throw new FailureError(errors.New("expected function to throw an error"), location);
    }
    return;
  }
  // Capture only the body. Native As and predicate control flow propagate unchanged.
  const matches = errorTypeSatisfies<T>(outcome.exception, predicate, targetType);
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected function %sto throw a value assignable to %s satisfying predicate (errors.As)", qualifier, targetType.String()), location);
  }
}

export class NegatedFunctionExpectation {
  private body: () => void;

  constructor(body: () => void) {
    this.body = body;
  }

  public function toThrowSatisfying(predicate: (exception: error) => boolean): void {
    checkFunctionThrowPredicate(this.body, predicate, true, callerLocation());
  }

  public function toThrowTypeSatisfying<T>(predicate: (value: T) => boolean): void {
    checkFunctionThrowTypePredicate<T>(this.body, predicate, true, callerLocation());
  }

  public function toThrow(): void {
    const location = callerLocation();
    try {
      const outcome = invokeFunctionExpectation(this.body);
      if (outcome.threw) {
        throw fmt.Errorf("expected function not to throw, got %v", outcome.exception);
      }
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toThrowMessage(fragment: string): void {
    const location = callerLocation();
    try {
      validateThrowMessage(fragment);
      const outcome = invokeFunctionExpectation(this.body);
      if (outcome.threw) {
        const message = functionThrowMessage(outcome);
        if (strings.Contains(message, fragment)) {
          throw fmt.Errorf("expected function not to throw containing %q, got %q", fragment, message);
        }
      }
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toThrowCause(target: error): void {
    const location = callerLocation();
    try {
      const outcome = invokeFunctionExpectation(this.body);
      if (outcome.threw && errors.Is(outcome.exception, target)) {
        throw fmt.Errorf("expected function not to throw matching %v (errors.Is)", target);
      }
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toThrowType<T>(): void {
    const location = callerLocation();
    try {
      const targetType = checkedErrorMatchType<T>("toThrowType");
      const outcome = invokeFunctionExpectation(this.body);
      const target = reflect.New(targetType);
      if (outcome.threw && errors.As(outcome.exception, target.Interface())) {
        throw fmt.Errorf("expected function not to throw a value assignable to %s (errors.As)", targetType.String());
      }
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }
}

export class FunctionExpectation {
  private body: () => void;
  public not: NegatedFunctionExpectation;

  constructor(body: () => void) {
    this.body = body;
    this.not = new NegatedFunctionExpectation(body);
  }

  public function toThrowSatisfying(predicate: (exception: error) => boolean): void {
    checkFunctionThrowPredicate(this.body, predicate, false, callerLocation());
  }

  public function toThrowTypeSatisfying<T>(predicate: (value: T) => boolean): void {
    checkFunctionThrowTypePredicate<T>(this.body, predicate, false, callerLocation());
  }

  public function toThrow(): error {
    const location = callerLocation();
    try {
      return requireFunctionThrow(invokeFunctionExpectation(this.body));
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toThrowMessage(fragment: string): void {
    const location = callerLocation();
    try {
      validateThrowMessage(fragment);
      const outcome = invokeFunctionExpectation(this.body);
      requireFunctionThrow(outcome);
      const message = functionThrowMessage(outcome);
      if (!strings.Contains(message, fragment)) {
        throw fmt.Errorf("expected error message %q to contain %q", message, fragment);
      }
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toThrowCause(target: error): void {
    const location = callerLocation();
    try {
      expectErrorIs(requireFunctionThrow(invokeFunctionExpectation(this.body)), target);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toThrowType<T>(target: *T): void {
    const location = callerLocation();
    try {
      validateErrorDestination<T>(target, "toThrowType");
      expectErrorAs<T>(requireFunctionThrow(invokeFunctionExpectation(this.body)), target);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }
}

export function expectFunction(body: () => void): FunctionExpectation {
  return new FunctionExpectation(body);
}

function isNilValue<T>(actual: T): boolean {
  const value = reflect.ValueOf(actual);
  if (!value.IsValid()) {
    return true;
  }
  const kind = value.Kind();
  if (kind == reflect.Chan || kind == reflect.Func || kind == reflect.Interface || kind == reflect.Map || kind == reflect.Pointer || kind == reflect.Slice) {
    return value.IsNil();
  }
  return false;
}

function checkSameValue<T>(actual: T, expected: T, negated: boolean): void {
  const left = reflect.ValueOf(actual);
  const right = reflect.ValueOf(expected);
  let equal = !left.IsValid() && !right.IsValid();
  if (left.IsValid() && right.IsValid()) {
    if (!left.Comparable() || !right.Comparable()) {
      throw errors.New("toBe requires comparable values; use toEqual for collections");
    }
    equal = left.Equal(right);
    if (left.Type() == right.Type() && (left.Kind() == reflect.Float32 || left.Kind() == reflect.Float64)) {
      const a = left.Float();
      const b = right.Float();
      equal = (math.IsNaN(a) && math.IsNaN(b)) || (a == b && (a != 0 || math.Signbit(a) == math.Signbit(b)));
    }
  } else if ((left.IsValid() && !left.Comparable()) || (right.IsValid() && !right.Comparable())) {
    throw errors.New("toBe requires comparable values; use toEqual for collections");
  }
  if (equal == negated) {
    if (negated) {
      throw fmt.Errorf("did not expect the same value as %#v", diagnosticArgument(expected));
    }
    throw fmt.Errorf("expected the same value as %#v, got %#v", diagnosticArgument(expected), diagnosticArgument(actual));
  }
}

export function expectEqual<T>(actual: T, expected: T): void {
  if (!reflect.DeepEqual(actual, expected)) {
    if (reflect.TypeOf(actual) == reflect.TypeOf(expected) && reflect.ValueOf(actual).Kind() == reflect.String) {
      throw assertionError(fmt.Errorf("strings differ: %s", firstTextDifference(reflect.ValueOf(expected).String(), reflect.ValueOf(actual).String())));
    }
    throw assertionError(fmt.Errorf("expected %#v, got %#v", diagnosticArgument(expected), diagnosticArgument(actual)));
  }
}

function firstTextDifference(expected: string, actual: string): string {
  const expectedLines = strings.Split(expected, "\n");
  const actualLines = strings.Split(actual, "\n");
  let index = 0;
  for (; index < len(expectedLines) && index < len(actualLines); index++) {
    if (expectedLines[index] != actualLines[index]) {
      return fmt.Sprintf("line %d: expected %q, got %q", index + 1, expectedLines[index], actualLines[index]);
    }
  }
  if (index < len(expectedLines)) {
    return fmt.Sprintf("line %d: expected %q, got end of text", index + 1, expectedLines[index]);
  }
  return fmt.Sprintf("line %d: expected end of text, got %q", index + 1, actualLines[index]);
}

export function expectNotEqual<T>(actual: T, unexpected: T): void {
  if (reflect.DeepEqual(actual, unexpected)) {
    throw assertionError(fmt.Errorf("did not expect %#v", diagnosticArgument(actual)));
  }
}

export function expectTrue(value: boolean): void {
  if (!value) {
    throw assertionError(errors.New("expected true, got false"));
  }
}

export function expectFalse(value: boolean): void {
  if (value) {
    throw assertionError(errors.New("expected false, got true"));
  }
}

export function expectError(err: error): void {
  if (err == nil) {
    throw assertionError(errors.New("expected an error, got nil"));
  }
}

export function expectNoError(err: error): void {
  if (err != nil) {
    throw assertionError(fmt.Errorf("expected no error, got %v", err));
  }
}

export function expectErrorIs(err: error, target: error): void {
  if (!errors.Is(err, target)) {
    throw assertionError(fmt.Errorf("expected error %v to match %v (errors.Is)", err, target));
  }
}

function validateErrorDestination<T>(target: *T, matcher: string): void {
  if (target == nil) {
    throw fmt.Errorf("%s target must not be nil", matcher);
  }
  const targetType = reflect.ValueOf(target).Elem().Type();
  if (targetType.Kind() != reflect.Interface && !targetType.Implements(reflect.TypeFor<error>())) {
    throw fmt.Errorf("%s target must point to an error type or interface, got %s", matcher, targetType.String());
  }
}

function checkedErrorMatchType<T>(matcher: string): reflect.Type {
  const targetType = reflect.TypeFor<T>();
  if (targetType.Kind() != reflect.Interface && !targetType.Implements(reflect.TypeFor<error>())) {
    throw fmt.Errorf("%s requires an error type or interface, got %s", matcher, targetType.String());
  }
  return targetType;
}

export function expectErrorAs<T>(err: error, target: *T): void {
  const location = callerLocation();
  try {
    validateErrorDestination<T>(target, "expectErrorAs");
  } catch (failure: error) {
    throw new FailureError(failure, location);
  }
  const targetType = reflect.ValueOf(target).Elem().Type();
  if (!errors.As(err, target)) {
    throw assertionError(fmt.Errorf("expected error %v to contain a value assignable to %s (errors.As)", err, targetType.String()));
  }
}

export function expectContains(value: string, fragment: string): void {
  if (!strings.Contains(value, fragment)) {
    throw assertionError(fmt.Errorf("expected %q to contain %q", value, fragment));
  }
}

export function expectNotContains(value: string, fragment: string): void {
  if (strings.Contains(value, fragment)) {
    throw assertionError(fmt.Errorf("expected %q not to contain %q", value, fragment));
  }
}

export function expectMatches(value: string, pattern: string): void {
  const [matched, patternError] = regexp.MatchString(pattern, value);
  if (patternError != nil) {
    throw assertionError(fmt.Errorf("invalid regular expression %q: %w", pattern, patternError));
  }
  if (!matched) {
    throw assertionError(fmt.Errorf("expected %q to match %q", value, pattern));
  }
}

export function expectNotMatches(value: string, pattern: string): void {
  const [matched, patternError] = regexp.MatchString(pattern, value);
  if (patternError != nil) {
    throw assertionError(fmt.Errorf("invalid regular expression %q: %w", pattern, patternError));
  }
  if (matched) {
    throw assertionError(fmt.Errorf("expected %q not to match %q", value, pattern));
  }
}

export function expectThrows(body: () => void): error {
  if (body == nil) {
    throw assertionError(errors.New("expectThrows body must not be nil"));
  }
  try {
    body();
  } catch (err: error) {
    return err;
  }
  throw assertionError(errors.New("expected function to throw an error"));
}

export function expectThrowsMessage(body: () => void, fragment: string): void {
  if (fragment == "") {
    throw assertionError(errors.New("expected error message fragment must not be empty"));
  }
  const location = callerLocation();
  let err: error = nil;
  try {
    err = expectThrows(body);
  } catch (failure: error) {
    throw new FailureError(failure, location);
  }
  if (!strings.Contains(err.Error(), fragment)) {
    throw assertionError(fmt.Errorf("expected error message %q to contain %q", err.Error(), fragment));
  }
}
