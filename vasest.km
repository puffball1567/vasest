export function expectMockReturn<R>(actual: MockReturnSource<R>): MockReturnExpectation<R> {
  return new MockReturnExpectation<R>(actual);
}

function mockReturnSnapshot<R>(actual: MockReturnSource<R>, location: TestLocation): MockResult<R>[] {
  if (isNilValue<MockReturnSource<R>>(actual)) {
    throw new FailureError(errors.New("mock return source must not be nil"), location);
  }
  return actual.results();
}

function mockReturnCount<R>(results: MockResult<R>[]): int {
  let count = 0;
  for (const result of results) {
    if (result.status == "return") {
      count++;
    }
  }
  return count;
}

function checkMockReturned<R>(actual: MockReturnSource<R>, negated: boolean, location: TestLocation): void {
  const results = mockReturnSnapshot<R>(actual, location);
  const count = mockReturnCount<R>(results);
  if ((count > 0) == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock not to have returned, got %d return(s)", count), location);
    }
    throw new FailureError(errors.New("expected mock to have returned, got no returns"), location);
  }
}

function checkMockReturnedTimes<R>(actual: MockReturnSource<R>, expected: int, negated: boolean, location: TestLocation): void {
  if (expected < 0) {
    throw new FailureError(errors.New("expected mock return count must not be negative"), location);
  }
  const count = mockReturnCount<R>(mockReturnSnapshot<R>(actual, location));
  if ((count == expected) == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock not to have returned %d time(s), got %d", expected, count), location);
    }
    throw new FailureError(fmt.Errorf("expected mock to have returned %d time(s), got %d", expected, count), location);
  }
}

function checkMockReturnedWith<R>(actual: MockReturnSource<R>, expected: R, negated: boolean, location: TestLocation): void {
  const results = mockReturnSnapshot<R>(actual, location);
  let matches = false;
  for (const result of results) {
    if (result.status == "return" && reflect.DeepEqual(result.value, expected)) {
      matches = true;
      break;
    }
  }
  if (matches == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock not to have returned %#v, got results %#v", diagnosticArgument(expected), diagnosticArgument(results)), location);
    }
    throw new FailureError(fmt.Errorf("expected mock to have returned %#v, got results %#v", diagnosticArgument(expected), diagnosticArgument(results)), location);
  }
}

function checkMockIndexedReturn<R>(actual: MockReturnSource<R>, index: int, expected: R, last: boolean, negated: boolean, location: TestLocation): void {
  if (!last && index < 1) {
    throw new FailureError(errors.New("mock call index must be at least 1"), location);
  }
  const results = mockReturnSnapshot<R>(actual, location);
  let name = fmt.Sprintf("call %d", index);
  if (last) {
    index = len(results);
    name = "last call";
  }
  const present = index > 0 && index <= len(results);
  const matches = present && results[index - 1].status == "return" && reflect.DeepEqual(results[index - 1].value, expected);
  if (matches == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock %s not to have returned %#v", name, diagnosticArgument(expected)), location);
    }
    if (!present) {
      throw new FailureError(fmt.Errorf("expected mock %s to return %#v, got %d call(s)", name, diagnosticArgument(expected), len(results)), location);
    }
    if (results[index - 1].status != "return") {
      throw new FailureError(fmt.Errorf("expected mock %s to return %#v, got status %q", name, diagnosticArgument(expected), results[index - 1].status), location);
    }
    throw new FailureError(fmt.Errorf("expected mock %s to return %#v, got %#v", name, diagnosticArgument(expected), diagnosticArgument(results[index - 1].value)), location);
  }
}

function checkMockReturnPredicate<R>(actual: MockReturnSource<R>, predicate: (value: R) => boolean, negated: boolean, location: TestLocation): void {
  if (predicate == nil) {
    throw new FailureError(errors.New("toHaveReturnedSatisfying predicate must not be nil"), location);
  }
  const results = mockReturnSnapshot<R>(actual, location);
  let matches = false;
  let checked = 0;
  for (const result of results) {
    if (result.status == "return") {
      checked++;
      if (predicate(result.value)) {
        matches = true;
        break;
      }
    }
  }
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected mock %sto have a returned value satisfying predicate, checked %d returned value(s) across %d call(s)", qualifier, checked, len(results)), location);
  }
}

function checkMockIndexedReturnPredicate<R>(actual: MockReturnSource<R>, index: int, predicate: (value: R) => boolean, last: boolean, negated: boolean, location: TestLocation): void {
  let matcher = "toHaveNthReturnedSatisfying";
  if (last) {
    matcher = "toHaveLastReturnedSatisfying";
  }
  if (predicate == nil) {
    throw new FailureError(fmt.Errorf("%s predicate must not be nil", matcher), location);
  }
  if (!last && index < 1) {
    throw new FailureError(errors.New("mock call index must be at least 1"), location);
  }
  const results = mockReturnSnapshot<R>(actual, location);
  let name = fmt.Sprintf("call %d", index);
  if (last) {
    index = len(results);
    name = "last call";
  }
  if (index < 1 || index > len(results)) {
    if (negated) {
      return;
    }
    throw new FailureError(fmt.Errorf("expected mock %s to return a value satisfying predicate, got %d call(s)", name, len(results)), location);
  }
  const result = results[index - 1];
  if (result.status != "return") {
    if (negated) {
      return;
    }
    throw new FailureError(fmt.Errorf("expected mock %s to return a value satisfying predicate, got status %q", name, result.status), location);
  }
  if (predicate(result.value) == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock %s returned value not to satisfy predicate", name), location);
    }
    throw new FailureError(fmt.Errorf("expected mock %s returned value to satisfy predicate", name), location);
  }
}

