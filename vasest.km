  public function toHaveNthThrownCause(index: int, target: error): void {
    checkMockOutcomeCause(this.actual, index, target, false, true, callerLocation());
  }

  public function toHaveLastThrownCause(target: error): void {
    checkMockOutcomeCause(this.actual, 0, target, true, true, callerLocation());
  }

  public function toHaveNthThrownType<T>(index: int): void {
    checkMockOutcomeNotType<T>(this.actual, index, false, "toHaveNthThrownType", callerLocation());
  }

  public function toHaveLastThrownType<T>(): void {
    checkMockOutcomeNotType<T>(this.actual, 0, true, "toHaveLastThrownType", callerLocation());
  }
}

