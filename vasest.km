import go bytes from "bytes";
import go cmp from "cmp";
import go sha256 from "crypto/sha256";
import go errors from "errors";
import go json from "encoding/json";
import go fmt from "fmt";
import go io from "io";
import go math from "math";
import go rand from "math/rand";
import go os from "os";
import go filepath from "path/filepath";
import go regexp from "regexp";
import go reflect from "reflect";
import go runtime from "runtime";
import go strings from "strings";
import go strconv from "strconv";
import go sync from "sync";
import go time from "time";
import go utf8 from "unicode/utf8";

export struct TestLocation {
  public file: string;
  public line: int;
  public source: string;
}

struct RerunSuite {
  public name: string;
  public wholeSuite: boolean;
  public cases: string[];
}

struct RerunSelection {
  public all: boolean;
  public suites: RerunSuite[];
}

// JSON syntax remains the decoder's responsibility. Check escapes before it can
// replace an unpaired UTF-16 surrogate with a different, valid identifier.
function hasUnpairedJSONSurrogate(text: string): boolean {
  let inString = false;
  for (let index = 0; index < len(text); index++) {
    const character = text[index:index + 1];
    if (character == "\"") {
      inString = !inString;
      continue;
    }
    if (!inString || character != "\\" || index + 1 >= len(text)) {
      continue;
    }
    if (text[index + 1:index + 2] != "u") {
      index++;
      continue;
    }
    if (index + 6 > len(text)) {
      return false;
    }
    const [unit, parseError] = strconv.ParseUint(text[index + 2:index + 6], 16, 16);
    if (parseError != nil) {
      return false;
    }
    if (unit >= 0xdc00 && unit <= 0xdfff) {
      return true;
    }
    if (unit >= 0xd800 && unit <= 0xdbff) {
      if (index + 12 > len(text) || text[index + 6:index + 8] != "\\u") {
        return true;
      }
      const [low, lowError] = strconv.ParseUint(text[index + 8:index + 12], 16, 16);
      if (lowError != nil || low < 0xdc00 || low > 0xdfff) {
        return true;
      }
      index += 11;
    } else {
      index += 5;
    }
  }
  return false;
}

struct JSONFieldScope {
  object: boolean;
  names: string[];
  key: boolean;
}

// Token decoding preserves repeated keys and decodes escaped names. Fold names
// as the native struct decoder does, while keeping separate object scopes.
function duplicateJSONFieldError(text: string): error {
  const decoder = json.NewDecoder(strings.NewReader(text));
  decoder.UseNumber();
  const delimiterType = reflect.TypeOf(json.Delim(0));
  let scopes: JSONFieldScope[] = [];
  while (true) {
    const [token, tokenError] = decoder.Token();
    if (errors.Is(tokenError, io.EOF)) {
      return nil;
    }
    if (tokenError != nil) {
      return tokenError;
    }
    if (reflect.TypeOf(token) == delimiterType) {
      const delimiter = token as! json.Delim;
      if (delimiter == json.Delim(123) || delimiter == json.Delim(91)) {
        if (len(scopes) > 0) {
          scopes[len(scopes) - 1].key = true;
        }
        scopes = append(scopes, JSONFieldScope { object: delimiter == json.Delim(123), names: [], key: true });
      } else {
        scopes = scopes[0:len(scopes) - 1];
      }
      continue;
    }
    if (len(scopes) == 0 || !scopes[len(scopes) - 1].object) {
      continue;
    }
    let scope = scopes[len(scopes) - 1];
    if (scope.key) {
      const name = token as! string;
      for (const seen of scope.names) {
        if (strings.EqualFold(seen, name)) {
          return fmt.Errorf("duplicate JSON field %q", name);
        }
      }
      scope.names = append(scope.names, name);
    }
    scope.key = !scope.key;
    scopes[len(scopes) - 1] = scope;
  }
  return nil;
}

function readRerunSelection(text: string): RerunSelection {
  if (!utf8.ValidString(text)) {
    throw errors.New("rerun selection must be valid UTF-8");
  }
  if (hasUnpairedJSONSurrogate(text)) {
    throw errors.New("rerun selection must use paired Unicode surrogate escapes");
  }
  const fieldError = duplicateJSONFieldError(text);
  if (fieldError != nil) {
    throw fmt.Errorf("invalid rerun selection: %w", fieldError);
  }
  const target = reflect.New(reflect.TypeOf(RerunSelection { all: false, suites: [] }));
  const parseError = json.Unmarshal(bytes.NewBufferString(text).Bytes(), target.Interface());
  if (parseError != nil) {
    throw fmt.Errorf("invalid rerun selection: %w", parseError);
  }
  return target.Elem().Interface() as! RerunSelection;
}

function matchesRerun(selection: RerunSelection, suite: string, name: string): boolean {
  if (selection.all) {
    return true;
  }
  for (const entry of selection.suites) {
    if (entry.name == suite) {
      if (entry.wholeSuite) {
        return true;
      }
      for (const selected of entry.cases) {
        if (selected == name) {
          return true;
        }
      }
    }
  }
  return false;
}

export struct TestFailure {
  public phase: string;
  public message: string;
  public location: TestLocation;
}

class FailureError implements error {
  private cause: error;
  private location: TestLocation;

  constructor(cause: error, location: TestLocation) {
    this.cause = cause;
    this.location = location;
  }

  public function Error(): string {
    return this.cause.Error();
  }

  public function Unwrap(): error {
    return this.cause;
  }

  public function origin(): TestLocation {
    return this.location;
  }
}

class SkipTestError implements error {
  private reason: string;

  constructor(reason: string) {
    this.reason = reason;
  }

  public function Error(): string {
    return this.reason;
  }
}

function testSkipReason(err: error): string {
  const skipType = reflect.TypeOf(new SkipTestError(""));
  let current = err;
  // Follow ordinary wrappers (including explicit locations). A joined error
  // is still a failure: one skipped branch must not hide another error.
  while (current != nil) {
    if (reflect.TypeOf(current) == skipType) {
      return current.Error();
    }
    current = errors.Unwrap(current);
  }
  return "";
}

export function skipTest(reason: string): void {
  if (strings.TrimSpace(reason) == "") {
    throw assertionError(errors.New("skipTest reason must not be empty"));
  }
  throw new SkipTestError(reason);
}

function emptyLocation(): TestLocation {
  return TestLocation { file: "", line: 0, source: "" };
}

class DiagnosticScan {
  private active: Map<string, boolean>;
  private remaining: int;
  private formatterType: reflect.Type;
  private goStringerType: reflect.Type;

  constructor() {
    this.active = makeMap[string, boolean]();
    this.remaining = 4096;
    let formatter: fmt.Formatter = nil;
    let goStringer: fmt.GoStringer = nil;
    this.formatterType = reflect.TypeOf(&formatter).Elem();
    this.goStringerType = reflect.TypeOf(&goStringer).Elem();
  }

  public function reason(value: reflect.Value, depth: int): string {
    if (!value.IsValid()) {
      return "";
    }
    // fmt owns explicit formatting methods; preserve their native behavior.
    if (value.CanInterface() && (value.Type().Implements(this.formatterType) || value.Type().Implements(this.goStringerType))) {
      return "";
    }
    if (depth >= 64 || this.remaining == 0) {
      return "diagnostic traversal limit";
    }
    this.remaining--;
    const kind = value.Kind();
    if (kind == reflect.Interface) {
      if (value.IsNil()) { return ""; }
      return this.reason(value.Elem(), depth + 1);
    }
    let identity = "";
    if (kind == reflect.Map || kind == reflect.Slice || kind == reflect.Ptr) {
      if (value.IsNil()) { return ""; }
      let length = 0;
      if (kind != reflect.Ptr) {
        length = value.Len();
        if (length == 0) { return ""; }
      }
      identity = fmt.Sprintf("%s:%x:%d", value.Type().String(), value.Pointer(), length);
      if (this.active[identity]) {
        return "cyclic value";
      }
      this.active[identity] = true;
    }
    try {
      if (kind == reflect.Ptr) {
        return this.reason(value.Elem(), depth + 1);
      }
      if (kind == reflect.Map) {
        const entries = value.MapRange();
        while (entries.Next()) {
          const keyReason = this.reason(entries.Key(), depth + 1);
          if (keyReason != "") { return keyReason; }
          const valueReason = this.reason(entries.Value(), depth + 1);
          if (valueReason != "") { return valueReason; }
        }
      }
      if (kind == reflect.Slice || kind == reflect.Array) {
        for (let index = 0; index < value.Len(); index++) {
          const reason = this.reason(value.Index(index), depth + 1);
          if (reason != "") { return reason; }
        }
      }
      if (kind == reflect.Struct) {
        for (let index = 0; index < value.NumField(); index++) {
          const reason = this.reason(value.Field(index), depth + 1);
          if (reason != "") { return reason; }
        }
      }
      return "";
    } finally {
      if (identity != "") { this.active[identity] = false; }
    }
  }
}

function diagnosticValue<T>(value: T): string {
  const reflected = reflect.ValueOf(value);
  const reason = new DiagnosticScan().reason(reflected, 0);
  if (reason != "") {
    return fmt.Sprintf("%s(<%s>)", reflected.Type().String(), reason);
  }
  return fmt.Sprintf("%#v", value);
}

class DiagnosticArgument<T> implements fmt.GoStringer {
  private value: T;

  constructor(value: T) {
    this.value = value;
  }

  public function GoString(): string {
    return diagnosticValue<T>(this.value);
  }
}

function diagnosticArgument<T>(value: T): DiagnosticArgument<T> {
  // Capture every argument before fmt calls any user formatting method.
  return new DiagnosticArgument<T>(value);
}

function assertionError(cause: error): error {
  const [pc, file, line, found] = runtime.Caller(2);
  if (!found || file == "" || line <= 0) {
    return cause;
  }
  let source = "go";
  if (strings.HasSuffix(file, ".km")) {
    source = "kinmokusei";
  }
  return new FailureError(cause, TestLocation { file: file, line: line, source: source });
}

function callerLocation(): TestLocation {
  const [pc, file, line, found] = runtime.Caller(2);
  if (!found || file == "" || line <= 0) {
    return emptyLocation();
  }
  let source = "go";
  if (strings.HasSuffix(file, ".km")) {
    source = "kinmokusei";
  }
  return TestLocation { file: file, line: line, source: source };
}

function failureLocation(err: error): TestLocation {
  const target = reflect.New(reflect.TypeOf(new FailureError(nil, emptyLocation())));
  if (errors.As(err, target.Interface())) {
    const values = target.Elem().MethodByName("Origin").Call([]);
    return values[0].Interface() as! TestLocation;
  }
  return emptyLocation();
}

function failureDetail(phase: string, err: error): TestFailure {
  return TestFailure { phase: phase, message: err.Error(), location: failureLocation(err) };
}

export function withTestLocation(file: string, line: int, body: () => void): void {
  if (strings.TrimSpace(file) == "" || strings.ContainsAny(file, "\r\n\x00")) {
    throw errors.New("test location file must be non-empty and contain no line breaks or NUL");
  }
  if (line <= 0) {
    throw errors.New("test location line must be positive");
  }
  if (body == nil) {
    throw errors.New("withTestLocation body must not be nil");
  }
  try {
    body();
  } catch (err: error) {
    throw new FailureError(err, TestLocation { file: file, line: line, source: "explicit" });
  }
}

struct MockImplementation<A, R> {
  body: (argument: A) => R;
}

export struct MockResult<R> {
  public status: string;
  public value: R;
  public exception: error;
}

class MockOutcome<R> {
  public result: MockResult<R>;

  constructor() {
    this.result.status = "incomplete";
  }
}

export interface MockCallSource<A> {
  function calls(): A[];
}

export interface MockReturnSource<R> {
  function results(): MockResult<R>[];
}

export struct MockOutcomeResult {
  public status: string;
  public exception: error;
}

export interface MockOutcomeSource {
  function outcomes(): MockOutcomeResult[];
}

export class MockFn<A, R> implements MockCallSource<A>, MockReturnSource<R>, MockOutcomeSource {
  private implementation: (argument: A) => R;
  private once: MockImplementation<A, R>[];
  private history: A[];
  private outcomeHistory: MockOutcome<R>[];
  private mutex: sync.Mutex;

  constructor(implementation: (argument: A) => R) {
    if (implementation == nil) {
      throw errors.New("mock implementation must not be nil");
    }
    this.implementation = implementation;
    this.once = [];
    this.history = [];
    this.outcomeHistory = [];
  }

  public function invoke(argument: A): R {
    this.mutex.Lock();
    this.history = append(this.history, argument);
    const outcome = new MockOutcome<R>();
    this.outcomeHistory = append(this.outcomeHistory, outcome);
    let implementation = this.implementation;
    if (len(this.once) > 0) {
      implementation = this.once[0].body;
      this.once[0] = MockImplementation<A, R> { body: nil };
      this.once = this.once[1:];
    }
    this.mutex.Unlock();
    // Call outside the lock so implementations can inspect or call the mock.
    let result = outcome.result;
    result.status = "panic";
    try {
      const value = implementation(argument);
      result = MockResult<R> { status: "return", value: value, exception: nil };
      return value;
    } catch (err: error) {
      result.status = "throw";
      result.exception = err;
      throw;
    } finally {
      this.mutex.Lock();
      outcome.result = result;
      this.mutex.Unlock();
    }
  }

  public function implement(implementation: (argument: A) => R): void {
    if (implementation == nil) {
      throw errors.New("mock implementation must not be nil");
    }
    this.mutex.Lock();
    this.implementation = implementation;
    this.mutex.Unlock();
  }

  public function implementOnce(implementation: (argument: A) => R): void {
    if (implementation == nil) {
      throw errors.New("mock implementation must not be nil");
    }
    this.mutex.Lock();
    this.once = append(this.once, MockImplementation<A, R> { body: implementation });
    this.mutex.Unlock();
  }

  public function returnValue(value: R): void {
    this.implement((argument: A): R => { return value; });
  }

  public function returnValueOnce(value: R): void {
    this.implementOnce((argument: A): R => { return value; });
  }

  public function throwError(exception: error): void {
    this.implement((argument: A): R => { throw exception; });
  }

  public function throwErrorOnce(exception: error): void {
    this.implementOnce((argument: A): R => { throw exception; });
  }

  public function callCount(): int {
    this.mutex.Lock();
    const count = len(this.history);
    this.mutex.Unlock();
    return count;
  }

  public function calls(): A[] {
    this.mutex.Lock();
    let copied: A[] = [];
    for (const argument of this.history) {
      copied = append(copied, argument);
    }
    this.mutex.Unlock();
    return copied;
  }

  public function clearCalls(): void {
    this.mutex.Lock();
    this.history = [];
    this.outcomeHistory = [];
    this.mutex.Unlock();
  }

  public function reset(implementation: (argument: A) => R): void {
    if (implementation == nil) {
      throw errors.New("mock implementation must not be nil");
    }
    this.mutex.Lock();
    this.implementation = implementation;
    this.once = [];
    this.history = [];
    this.outcomeHistory = [];
    this.mutex.Unlock();
  }

  public function results(): MockResult<R>[] {
    this.mutex.Lock();
    let copied: MockResult<R>[] = [];
    for (const outcome of this.outcomeHistory) {
      copied = append(copied, outcome.result);
    }
    this.mutex.Unlock();
    return copied;
  }

  public function expectReturnedTimes(expected: int): void {
    if (expected < 0) {
      throw assertionError(errors.New("expected mock return count must not be negative"));
    }
    let actual = 0;
    for (const result of this.results()) {
      if (result.status == "return") {
        actual++;
      }
    }
    if (actual != expected) {
      throw assertionError(fmt.Errorf("expected mock to return %d time(s), got %d", expected, actual));
    }
  }

  public function outcomes(): MockOutcomeResult[] {
    let copied: MockOutcomeResult[] = [];
    for (const result of this.results()) {
      copied = append(copied, MockOutcomeResult { status: result.status, exception: result.exception });
    }
    return copied;
  }

  public function expectReturnedWith(expected: R): void {
    const results = this.results();
    for (const result of results) {
      if (result.status == "return" && reflect.DeepEqual(result.value, expected)) {
        return;
      }
    }
    throw assertionError(fmt.Errorf("expected mock to return %#v, got results %#v", diagnosticArgument(expected), diagnosticArgument(results)));
  }

  public function expectNthReturnedWith(index: int, expected: R): void {
    const result = this.resultAt(index, callerLocation());
    if (result.status != "return") {
      throw assertionError(fmt.Errorf("expected mock call %d to return %#v, got status %q", index, diagnosticArgument(expected), result.status));
    }
    if (!reflect.DeepEqual(result.value, expected)) {
      throw assertionError(fmt.Errorf("expected mock call %d to return %#v, got %#v", index, diagnosticArgument(expected), diagnosticArgument(result.value)));
    }
  }

  public function expectThrownTimes(expected: int): void {
    if (expected < 0) {
      throw assertionError(errors.New("expected mock throw count must not be negative"));
    }
    let actual = 0;
    for (const result of this.results()) {
      if (result.status == "throw") {
        actual++;
      }
    }
    if (actual != expected) {
      throw assertionError(fmt.Errorf("expected mock to throw %d time(s), got %d", expected, actual));
    }
  }

  public function expectNthThrownMessage(index: int, fragment: string): void {
    if (fragment == "") {
      throw assertionError(errors.New("expected mock error fragment must not be empty"));
    }
    const result = this.resultAt(index, callerLocation());
    if (result.status != "throw") {
      throw assertionError(fmt.Errorf("expected mock call %d to throw containing %q, got status %q", index, fragment, result.status));
    }
    let message = "";
    if (result.exception != nil) {
      message = result.exception.Error();
    }
    if (!strings.Contains(message, fragment)) {
      throw assertionError(fmt.Errorf("expected mock call %d to throw containing %q, got %q", index, fragment, message));
    }
  }

  private function resultAt(index: int, location: TestLocation): MockResult<R> {
    if (index < 1) {
      throw new FailureError(errors.New("mock call index must be at least 1"), location);
    }
    const results = this.results();
    if (index > len(results)) {
      throw new FailureError(fmt.Errorf("expected mock call %d, got %d call(s)", index, len(results)), location);
    }
    return results[index - 1];
  }

  public function expectCalledTimes(expected: int): void {
    if (expected < 0) {
      throw assertionError(errors.New("expected mock call count must not be negative"));
    }
    const actual = this.callCount();
    if (actual != expected) {
      throw assertionError(fmt.Errorf("expected mock to be called %d time(s), got %d", expected, actual));
    }
  }

  public function expectCalledWith(expected: A): void {
    const calls = this.calls();
    for (const argument of calls) {
      if (reflect.DeepEqual(argument, expected)) {
        return;
      }
    }
    throw assertionError(fmt.Errorf("expected mock to be called with %#v, got calls %#v", diagnosticArgument(expected), diagnosticArgument(calls)));
  }

  public function expectNthCalledWith(index: int, expected: A): void {
    if (index < 1) {
      throw assertionError(errors.New("mock call index must be at least 1"));
    }
    const calls = this.calls();
    if (index > len(calls)) {
      throw assertionError(fmt.Errorf("expected mock call %d, got %d call(s)", index, len(calls)));
    }
    const actual = calls[index - 1];
    if (!reflect.DeepEqual(actual, expected)) {
      throw assertionError(fmt.Errorf("expected mock call %d with %#v, got %#v", index, diagnosticArgument(expected), diagnosticArgument(actual)));
    }
  }
}

export struct MockActionResult {
  public status: string;
  public exception: error;
}

export class MockAction<A> implements MockCallSource<A>, MockOutcomeSource {
  private mock: MockFn<A, boolean>;

  constructor(implementation: (argument: A) => void) {
    if (implementation == nil) {
      throw errors.New("mock implementation must not be nil");
    }
    this.mock = new MockFn<A, boolean>((argument: A): boolean => {
      implementation(argument);
      return true;
    });
  }

  public function invoke(argument: A): void {
    this.mock.invoke(argument);
  }

  public function implement(implementation: (argument: A) => void): void {
    if (implementation == nil) {
      throw errors.New("mock implementation must not be nil");
    }
    this.mock.implement((argument: A): boolean => {
      implementation(argument);
      return true;
    });
  }

  public function implementOnce(implementation: (argument: A) => void): void {
    if (implementation == nil) {
      throw errors.New("mock implementation must not be nil");
    }
    this.mock.implementOnce((argument: A): boolean => {
      implementation(argument);
      return true;
    });
  }

  public function throwError(exception: error): void {
    this.mock.throwError(exception);
  }

  public function throwErrorOnce(exception: error): void {
    this.mock.throwErrorOnce(exception);
  }

  public function callCount(): int {
    return this.mock.callCount();
  }

  public function calls(): A[] {
    return this.mock.calls();
  }

  public function clearCalls(): void {
    this.mock.clearCalls();
  }

  public function reset(implementation: (argument: A) => void): void {
    if (implementation == nil) {
      throw errors.New("mock implementation must not be nil");
    }
    this.mock.reset((argument: A): boolean => {
      implementation(argument);
      return true;
    });
  }

  public function results(): MockActionResult[] {
    let copied: MockActionResult[] = [];
    for (const result of this.mock.results()) {
      copied = append(copied, MockActionResult { status: result.status, exception: result.exception });
    }
    return copied;
  }

  public function outcomes(): MockOutcomeResult[] {
    return this.mock.outcomes();
  }

  public function expectReturnedTimes(expected: int): void {
    const location = callerLocation();
    try {
      this.mock.expectReturnedTimes(expected);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function expectThrownTimes(expected: int): void {
    const location = callerLocation();
    try {
      this.mock.expectThrownTimes(expected);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function expectNthThrownMessage(index: int, fragment: string): void {
    const location = callerLocation();
    try {
      this.mock.expectNthThrownMessage(index, fragment);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function expectCalledTimes(expected: int): void {
    const location = callerLocation();
    try {
      this.mock.expectCalledTimes(expected);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function expectCalledWith(expected: A): void {
    const location = callerLocation();
    try {
      this.mock.expectCalledWith(expected);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function expectNthCalledWith(index: int, expected: A): void {
    const location = callerLocation();
    try {
      this.mock.expectNthCalledWith(index, expected);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }
}

export class NegatedMockExpectation<A> {
  private actual: MockCallSource<A>;

  constructor(actual: MockCallSource<A>) {
    this.actual = actual;
  }

  public function toHaveBeenCalled(): void {
    checkMockCalled<A>(this.actual, true, callerLocation());
  }

  public function toHaveBeenCalledTimes(expected: int): void {
    checkMockCalledTimes<A>(this.actual, expected, true, callerLocation());
  }

  public function toHaveBeenCalledWith(expected: A): void {
    checkMockCalledWith<A>(this.actual, expected, true, callerLocation());
  }

  public function toHaveBeenNthCalledWith(index: int, expected: A): void {
    checkMockIndexedCall<A>(this.actual, index, expected, false, true, callerLocation());
  }

  public function toHaveBeenLastCalledWith(expected: A): void {
    checkMockIndexedCall<A>(this.actual, 0, expected, true, true, callerLocation());
  }

  public function toHaveBeenCalledSatisfying(predicate: (argument: A) => boolean): void {
    checkMockCallPredicate<A>(this.actual, predicate, true, callerLocation());
  }

  public function toHaveBeenNthCalledSatisfying(index: int, predicate: (argument: A) => boolean): void {
    checkMockIndexedCallPredicate<A>(this.actual, index, predicate, false, true, callerLocation());
  }

  public function toHaveBeenLastCalledSatisfying(predicate: (argument: A) => boolean): void {
    checkMockIndexedCallPredicate<A>(this.actual, 0, predicate, true, true, callerLocation());
  }
}

export class MockExpectation<A> {
  private actual: MockCallSource<A>;
  public not: NegatedMockExpectation<A>;

  constructor(actual: MockCallSource<A>) {
    this.actual = actual;
    this.not = new NegatedMockExpectation<A>(actual);
  }

  public function toHaveBeenCalled(): void {
    checkMockCalled<A>(this.actual, false, callerLocation());
  }

  public function toHaveBeenCalledTimes(expected: int): void {
    checkMockCalledTimes<A>(this.actual, expected, false, callerLocation());
  }

  public function toHaveBeenCalledWith(expected: A): void {
    checkMockCalledWith<A>(this.actual, expected, false, callerLocation());
  }

  public function toHaveBeenNthCalledWith(index: int, expected: A): void {
    checkMockIndexedCall<A>(this.actual, index, expected, false, false, callerLocation());
  }

  public function toHaveBeenLastCalledWith(expected: A): void {
    checkMockIndexedCall<A>(this.actual, 0, expected, true, false, callerLocation());
  }

  public function toHaveBeenCalledSatisfying(predicate: (argument: A) => boolean): void {
    checkMockCallPredicate<A>(this.actual, predicate, false, callerLocation());
  }

  public function toHaveBeenNthCalledSatisfying(index: int, predicate: (argument: A) => boolean): void {
    checkMockIndexedCallPredicate<A>(this.actual, index, predicate, false, false, callerLocation());
  }

  public function toHaveBeenLastCalledSatisfying(predicate: (argument: A) => boolean): void {
    checkMockIndexedCallPredicate<A>(this.actual, 0, predicate, true, false, callerLocation());
  }
}

export function expectMock<A>(actual: MockCallSource<A>): MockExpectation<A> {
  return new MockExpectation<A>(actual);
}

function mockCallSnapshot<A>(actual: MockCallSource<A>, location: TestLocation): A[] {
  if (isNilValue<MockCallSource<A>>(actual)) {
    throw new FailureError(errors.New("mock call source must not be nil"), location);
  }
  return actual.calls();
}

function checkMockCalled<A>(actual: MockCallSource<A>, negated: boolean, location: TestLocation): void {
  const calls = mockCallSnapshot<A>(actual, location);
  if ((len(calls) > 0) == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock not to have been called, got %d call(s)", len(calls)), location);
    }
    throw new FailureError(errors.New("expected mock to have been called, got no calls"), location);
  }
}

function checkMockCalledTimes<A>(actual: MockCallSource<A>, expected: int, negated: boolean, location: TestLocation): void {
  if (expected < 0) {
    throw new FailureError(errors.New("expected mock call count must not be negative"), location);
  }
  const calls = mockCallSnapshot<A>(actual, location);
  if ((len(calls) == expected) == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock not to have been called %d time(s), got %d", expected, len(calls)), location);
    }
    throw new FailureError(fmt.Errorf("expected mock to have been called %d time(s), got %d", expected, len(calls)), location);
  }
}

function checkMockCalledWith<A>(actual: MockCallSource<A>, expected: A, negated: boolean, location: TestLocation): void {
  const calls = mockCallSnapshot<A>(actual, location);
  let matches = false;
  for (const argument of calls) {
    if (reflect.DeepEqual(argument, expected)) {
      matches = true;
      break;
    }
  }
  if (matches == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock not to have been called with %#v, got calls %#v", diagnosticArgument(expected), diagnosticArgument(calls)), location);
    }
    throw new FailureError(fmt.Errorf("expected mock to have been called with %#v, got calls %#v", diagnosticArgument(expected), diagnosticArgument(calls)), location);
  }
}

function checkMockIndexedCall<A>(actual: MockCallSource<A>, index: int, expected: A, last: boolean, negated: boolean, location: TestLocation): void {
  if (!last && index < 1) {
    throw new FailureError(errors.New("mock call index must be at least 1"), location);
  }
  const calls = mockCallSnapshot<A>(actual, location);
  let name = fmt.Sprintf("call %d", index);
  if (last) {
    index = len(calls);
    name = "last call";
  }
  const present = index > 0 && index <= len(calls);
  const matches = present && reflect.DeepEqual(calls[index - 1], expected);
  if (matches == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock %s not to have argument %#v", name, diagnosticArgument(expected)), location);
    }
    if (!present) {
      throw new FailureError(fmt.Errorf("expected mock %s with %#v, got %d call(s)", name, diagnosticArgument(expected), len(calls)), location);
    }
    throw new FailureError(fmt.Errorf("expected mock %s with %#v, got %#v", name, diagnosticArgument(expected), diagnosticArgument(calls[index - 1])), location);
  }
}

function checkMockCallPredicate<A>(actual: MockCallSource<A>, predicate: (argument: A) => boolean, negated: boolean, location: TestLocation): void {
  if (predicate == nil) {
    throw new FailureError(errors.New("toHaveBeenCalledSatisfying predicate must not be nil"), location);
  }
  const calls = mockCallSnapshot<A>(actual, location);
  let matches = false;
  let checked = 0;
  for (const argument of calls) {
    checked++;
    if (predicate(argument)) {
      matches = true;
      break;
    }
  }
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected mock %sto have a call argument satisfying predicate, checked %d of %d call(s)", qualifier, checked, len(calls)), location);
  }
}

function checkMockIndexedCallPredicate<A>(actual: MockCallSource<A>, index: int, predicate: (argument: A) => boolean, last: boolean, negated: boolean, location: TestLocation): void {
  let matcher = "toHaveBeenNthCalledSatisfying";
  if (last) {
    matcher = "toHaveBeenLastCalledSatisfying";
  }
  if (predicate == nil) {
    throw new FailureError(fmt.Errorf("%s predicate must not be nil", matcher), location);
  }
  if (!last && index < 1) {
    throw new FailureError(errors.New("mock call index must be at least 1"), location);
  }
  const calls = mockCallSnapshot<A>(actual, location);
  let name = fmt.Sprintf("call %d", index);
  if (last) {
    index = len(calls);
    name = "last call";
  }
  if (index > len(calls) || index < 1) {
    if (negated) {
      return;
    }
    throw new FailureError(fmt.Errorf("expected mock %s with argument satisfying predicate, got %d call(s)", name, len(calls)), location);
  }
  if (predicate(calls[index - 1]) == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock %s argument not to satisfy predicate", name), location);
    }
    throw new FailureError(fmt.Errorf("expected mock %s argument to satisfy predicate", name), location);
  }
}

export class NegatedMockReturnExpectation<R> {
  private actual: MockReturnSource<R>;

  constructor(actual: MockReturnSource<R>) {
    this.actual = actual;
  }

  public function toHaveReturned(): void {
    checkMockReturned<R>(this.actual, true, callerLocation());
  }

  public function toHaveReturnedTimes(expected: int): void {
    checkMockReturnedTimes<R>(this.actual, expected, true, callerLocation());
  }

  public function toHaveReturnedWith(expected: R): void {
    checkMockReturnedWith<R>(this.actual, expected, true, callerLocation());
  }

  public function toHaveNthReturnedWith(index: int, expected: R): void {
    checkMockIndexedReturn<R>(this.actual, index, expected, false, true, callerLocation());
  }

  public function toHaveLastReturnedWith(expected: R): void {
    checkMockIndexedReturn<R>(this.actual, 0, expected, true, true, callerLocation());
  }

  public function toHaveReturnedSatisfying(predicate: (value: R) => boolean): void {
    checkMockReturnPredicate<R>(this.actual, predicate, true, callerLocation());
  }

  public function toHaveNthReturnedSatisfying(index: int, predicate: (value: R) => boolean): void {
    checkMockIndexedReturnPredicate<R>(this.actual, index, predicate, false, true, callerLocation());
  }

  public function toHaveLastReturnedSatisfying(predicate: (value: R) => boolean): void {
    checkMockIndexedReturnPredicate<R>(this.actual, 0, predicate, true, true, callerLocation());
  }
}

