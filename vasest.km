  }

  public function toHaveReturnedWith(expected: R): void {
    checkMockReturnedWith<R>(this.actual, expected, false, callerLocation());
  }

  public function toHaveNthReturnedWith(index: int, expected: R): void {
    checkMockIndexedReturn<R>(this.actual, index, expected, false, false, callerLocation());
  }

  public function toHaveLastReturnedWith(expected: R): void {
    checkMockIndexedReturn<R>(this.actual, 0, expected, true, false, callerLocation());
