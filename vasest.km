export function expectMockOutcome(actual: MockOutcomeSource): MockOutcomeExpectation {
  return new MockOutcomeExpectation(actual);
}

function mockOutcomeSnapshot(actual: MockOutcomeSource, location: TestLocation): MockOutcomeResult[] {
  if (isNilValue<MockOutcomeSource>(actual)) {
    throw new FailureError(errors.New("mock outcome source must not be nil"), location);
  }
  return actual.outcomes();
}

function mockOutcomeCount(results: MockOutcomeResult[], status: string): int {
  let count = 0;
  for (const result of results) {
    if (result.status == status) {
      count++;
    }
  }
  return count;
}

function checkMockOutcome(actual: MockOutcomeSource, status: string, negated: boolean, location: TestLocation): void {
  const count = mockOutcomeCount(mockOutcomeSnapshot(actual, location), status);
  let verb = "returned";
  if (status == "throw") {
    verb = "thrown";
  }
  if ((count > 0) == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock not to have %s, got %d %s outcome(s)", verb, count, status), location);
    }
    throw new FailureError(fmt.Errorf("expected mock to have %s, got no %s outcomes", verb, status), location);
  }
}

function checkMockOutcomeTimes(actual: MockOutcomeSource, status: string, expected: int, negated: boolean, location: TestLocation): void {
  if (expected < 0) {
    throw new FailureError(fmt.Errorf("expected mock %s count must not be negative", status), location);
  }
  const count = mockOutcomeCount(mockOutcomeSnapshot(actual, location), status);
  let verb = "returned";
  if (status == "throw") {
    verb = "thrown";
  }
  if ((count == expected) == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock not to have %s %d time(s), got %d", verb, expected, count), location);
    }
    throw new FailureError(fmt.Errorf("expected mock to have %s %d time(s), got %d", verb, expected, count), location);
  }
}

function checkMockOutcomeMessage(actual: MockOutcomeSource, index: int, fragment: string, last: boolean, negated: boolean, location: TestLocation): void {
  if (!last && index < 1) {
    throw new FailureError(errors.New("mock call index must be at least 1"), location);
  }
  if (fragment == "") {
    throw new FailureError(errors.New("expected mock error fragment must not be empty"), location);
  }
  const results = mockOutcomeSnapshot(actual, location);
  let name = fmt.Sprintf("call %d", index);
  if (last) {
    index = len(results);
    name = "last call";
  }
  const present = index > 0 && index <= len(results);
  let message = "";
  let threw = false;
  if (present && results[index - 1].status == "throw") {
    threw = true;
    if (results[index - 1].exception != nil) {
      message = results[index - 1].exception.Error();
    }
  }
  const matches = threw && strings.Contains(message, fragment);
  if (matches == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock %s not to have thrown containing %q, got %q", name, fragment, message), location);
    }
    if (!present) {
      throw new FailureError(fmt.Errorf("expected mock %s to throw containing %q, got %d call(s)", name, fragment, len(results)), location);
    }
    if (!threw) {
      throw new FailureError(fmt.Errorf("expected mock %s to throw containing %q, got status %q", name, fragment, results[index - 1].status), location);
    }
    throw new FailureError(fmt.Errorf("expected mock %s to throw containing %q, got %q", name, fragment, message), location);
  }
}

struct MockThrownSelection {
  name: string;
  calls: int;
  present: boolean;
  status: string;
  exception: error;
}

function selectMockThrown(actual: MockOutcomeSource, index: int, last: boolean, location: TestLocation): MockThrownSelection {
  if (!last && index < 1) {
    throw new FailureError(errors.New("mock call index must be at least 1"), location);
  }
  const results = mockOutcomeSnapshot(actual, location);
  let name = fmt.Sprintf("call %d", index);
  if (last) {
    index = len(results);
    name = "last call";
  }
  const present = index > 0 && index <= len(results);
  let status = "";
  let exception: error = nil;
  if (present) {
    status = results[index - 1].status;
    exception = results[index - 1].exception;
  }
  return MockThrownSelection { name: name, calls: len(results), present: present, status: status, exception: exception };
}

function requireMockThrown(selected: MockThrownSelection, location: TestLocation): void {
  if (!selected.present) {
    throw new FailureError(fmt.Errorf("expected mock %s to throw, got %d call(s)", selected.name, selected.calls), location);
  }
  if (selected.status != "throw") {
    throw new FailureError(fmt.Errorf("expected mock %s to throw, got status %q", selected.name, selected.status), location);
  }
}

function checkMockThrownPredicate(actual: MockOutcomeSource, predicate: (exception: error) => boolean, negated: boolean, location: TestLocation): void {
  if (predicate == nil) {
    throw new FailureError(errors.New("mock throw predicate must not be nil"), location);
  }
  const results = mockOutcomeSnapshot(actual, location);
  let checked = 0;
  let matches = false;
  for (const result of results) {
    if (result.status == "throw") {
      checked++;
      if (predicate(result.exception)) {
        matches = true;
        break;
      }
    }
  }
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected mock %sto have a thrown error satisfying predicate, checked %d thrown error(s) across %d call(s)", qualifier, checked, len(results)), location);
  }
}

function checkMockIndexedThrownPredicate(actual: MockOutcomeSource, index: int, predicate: (exception: error) => boolean, last: boolean, negated: boolean, location: TestLocation): void {
  if (predicate == nil) {
    throw new FailureError(errors.New("mock throw predicate must not be nil"), location);
  }
  const selected = selectMockThrown(actual, index, last, location);
  if (!negated) {
    requireMockThrown(selected, location);
  }
  const matches = selected.present && selected.status == "throw" && predicate(selected.exception);
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected mock %s %sto have thrown an error satisfying predicate", selected.name, qualifier), location);
  }
}

function checkedMockThrownPredicateType<T>(predicate: (value: T) => boolean, matcher: string, location: TestLocation): reflect.Type {
  if (predicate == nil) {
    throw new FailureError(fmt.Errorf("%s predicate must not be nil", matcher), location);
  }
  try {
    return checkedErrorMatchType<T>(matcher);
  } catch (err: error) {
    throw new FailureError(err, location);
  }
}

function checkMockThrownTypePredicate<T>(actual: MockOutcomeSource, predicate: (value: T) => boolean, negated: boolean, location: TestLocation): void {
  const targetType = checkedMockThrownPredicateType<T>(predicate, "toHaveThrownTypeSatisfying", location);
  const results = mockOutcomeSnapshot(actual, location);
  let checked = 0;
  let matches = false;
  for (const result of results) {
    if (result.status == "throw") {
      checked++;
      if (errorTypeSatisfies<T>(result.exception, predicate, targetType)) {
        matches = true;
        break;
      }
    }
  }
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected mock %sto have thrown a value assignable to %s satisfying predicate (errors.As), checked %d thrown error(s) across %d call(s)", qualifier, targetType.String(), checked, len(results)), location);
  }
}

function checkMockIndexedThrownTypePredicate<T>(actual: MockOutcomeSource, index: int, predicate: (value: T) => boolean, last: boolean, negated: boolean, location: TestLocation): void {
  let matcher = "toHaveNthThrownTypeSatisfying";
  if (last) {
    matcher = "toHaveLastThrownTypeSatisfying";
  }
  const targetType = checkedMockThrownPredicateType<T>(predicate, matcher, location);
  const selected = selectMockThrown(actual, index, last, location);
  if (!negated) {
    requireMockThrown(selected, location);
  }
  const matches = selected.present && selected.status == "throw" && errorTypeSatisfies<T>(selected.exception, predicate, targetType);
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected mock %s %sto have thrown a value assignable to %s satisfying predicate (errors.As)", selected.name, qualifier, targetType.String()), location);
  }
}

function checkMockOutcomeCause(actual: MockOutcomeSource, index: int, target: error, last: boolean, negated: boolean, location: TestLocation): void {
  const selected = selectMockThrown(actual, index, last, location);
  if (!negated) {
    requireMockThrown(selected, location);
  }
  const matches = selected.present && selected.status == "throw" && errors.Is(selected.exception, target);
  if (matches == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected mock %s not to have thrown matching %v (errors.Is)", selected.name, target), location);
    }
    throw new FailureError(fmt.Errorf("expected mock %s to have thrown matching %v (errors.Is)", selected.name, target), location);
  }
}

function checkMockOutcomeType<T>(actual: MockOutcomeSource, index: int, target: *T, last: boolean, matcher: string, location: TestLocation): void {
  try {
    validateErrorDestination<T>(target, matcher);
  } catch (err: error) {
    throw new FailureError(err, location);
  }
  const selected = selectMockThrown(actual, index, last, location);
  requireMockThrown(selected, location);
  if (!errors.As(selected.exception, target)) {
    throw new FailureError(fmt.Errorf("expected mock %s to have thrown a value assignable to %s (errors.As)", selected.name, reflect.ValueOf(target).Elem().Type().String()), location);
  }
}

function checkMockOutcomeNotType<T>(actual: MockOutcomeSource, index: int, last: boolean, matcher: string, location: TestLocation): void {
  let targetType: reflect.Type = nil;
  try {
    targetType = checkedErrorMatchType<T>(matcher);
  } catch (err: error) {
    throw new FailureError(err, location);
  }
  const selected = selectMockThrown(actual, index, last, location);
  const target = reflect.New(targetType);
  if (selected.present && selected.status == "throw" && errors.As(selected.exception, target.Interface())) {
    throw new FailureError(fmt.Errorf("expected mock %s not to have thrown a value assignable to %s (errors.As)", selected.name, targetType.String()), location);
  }
}

struct Cleanup {
  body: () => void;
}

export class TestContext {
  private register: (body: () => void) => void;

  constructor(register: (body: () => void) => void) {
    if (register == nil) {
      throw errors.New("cleanup registrar must not be nil");
    }
    this.register = register;
  }

  public function cleanup(body: () => void): void {
    this.register(body);
  }

  public function tempDir(): string {
    let path = "";
    // Register first so a closed context cannot create an unowned resource.
    this.cleanup((): void => {
      if (path != "") {
        const cleanupError = os.RemoveAll(path);
        if (cleanupError != nil) {
          throw fmt.Errorf("temporary directory cleanup failed: %w", cleanupError);
        }
      }
    });
    const [created, createError] = os.MkdirTemp("", "vasest-*");
    if (createError != nil) {
      throw fmt.Errorf("cannot create temporary directory: %w", createError);
    }
    path = created;
    return path;
  }

  public function setEnv(name: string, value: string): void {
    const [previous, existed] = os.LookupEnv(name);
    let changed = false;
    this.cleanup((): void => {
      if (changed) {
        let restoreError: error = nil;
        if (existed) {
          restoreError = os.Setenv(name, previous);
        } else {
          restoreError = os.Unsetenv(name);
        }
        if (restoreError != nil) {
          throw fmt.Errorf("environment variable %q restore failed: %w", name, restoreError);
        }
      }
    });
    const setError = os.Setenv(name, value);
    if (setError != nil) {
      throw fmt.Errorf("cannot set environment variable %q: %w", name, setError);
    }
    changed = true;
  }
}

class CleanupScope {
  private pending: Cleanup[];
  private closed: boolean;

  constructor() {
    this.pending = [];
    this.closed = false;
  }

  public function context(): TestContext {
    return new TestContext((body: () => void): void => {
      if (body == nil) {
        throw errors.New("cleanup body must not be nil");
      }
      if (this.closed) {
        throw errors.New("test context is already closed");
      }
      this.pending = append(this.pending, Cleanup { body: body });
    });
  }

  public function drain(): TestFailure[] {
    let failures: TestFailure[] = [];
    try {
      while (len(this.pending) > 0) {
        const index = len(this.pending) - 1;
        const cleanup = this.pending[index];
        this.pending[index] = Cleanup { body: nil };
        this.pending = this.pending[:index];
        try {
          cleanup.body();
        } catch (err: error) {
          failures = append(failures, failureDetail("cleanup", err));
        }
      }
    } finally {
      try {
        // A native panic still unwinds the remaining registered callbacks.
        if (len(this.pending) > 0) {
          const remaining = this.drain();
          for (const failure of remaining) {
            failures = append(failures, failure);
          }
        }
      } finally {
        this.closed = true;
      }
    }
    return failures;
  }
}

struct FixtureInvocation {
  body: () => void;
}

struct TestCase {
  name: string;
  body: () => void;
  contextBody: (context: TestContext) => void;
  fixtureBody: (context: TestContext) => FixtureInvocation;
  kind: string;
}

struct IndexedTestRow<T> {
  value: T;
  index: int;
}

function indexedTestRows<T>(values: T[]): IndexedTestRow<T>[] {
  let rows: IndexedTestRow<T>[] = [];
  let index = 0;
  for (const value of values) {
    rows = append(rows, IndexedTestRow<T> { value: value, index: index });
    index++;
  }
  return rows;
}

function failureMessage(failures: TestFailure[]): string {
  let message = "";
  for (const failure of failures) {
    if (message != "") {
      message += "; ";
    }
    if (failure.phase == "afterEach" || failure.phase == "cleanup") {
      message += failure.phase + ": ";
    }
    message += failure.message;
  }
  return message;
}

function writeFailureDetails(writer: io.Writer, failures: TestFailure[]): void {
  const concise = len(failures) == 1 && failures[0].phase == "body" && failures[0].message != "";
  for (const failure of failures) {
    let message = failure.message;
    if (message == "") {
      message = "(empty error message)";
    }
    if (!concise) {
      fmt.Fprintf(writer, "  [%s] %s\n", failure.phase, message);
    }
    if (failure.location.line > 0) {
      fmt.Fprintf(writer, "    at %s:%d (%s)\n", failure.location.file, failure.location.line, failure.location.source);
    }
  }
}

export struct TestResult {
  public name: string;
  public passed: boolean;
  public message: string;
  public status: string;
  public durationNs: int64;
  public failures: TestFailure[];
}

function failedResult(name: string, message: string, durationNs: int64, failures: TestFailure[]): TestResult {
  let result = TestResult { name: name, passed: false, message: message, status: "fail", durationNs: durationNs, failures: [] };
  for (const failure of failures) {
    result.failures = append(result.failures, failure);
  }
  return result;
}

export struct Summary {
  public suite: string;
  public failOnTodo: boolean;
  public passed: int;
  public failed: int;
  public skipped: int;
  public todo: int;
  public durationNs: int64;
  public results: TestResult[];

  public function total(): int {
    return this.passed + this.failed;
  }

  public function success(): boolean {
    return (this.total() > 0 || this.skipped > 0 || this.todo > 0) && this.failed == 0 && !(this.failOnTodo && this.todo > 0);
  }

  public function exitCode(): int {
    if (this.success()) {
      return 0;
    }
    return 1;
  }
}

export class Suite {
  private name: string;
  private cases: TestCase[];
  private before: () => void;
  private after: () => void;
  private beforeContext: (context: TestContext) => void;
  private afterContext: (context: TestContext) => void;
  private beforeSuite: () => void;
  private beforeSuiteContext: (context: TestContext) => void;
  private afterSuite: () => void;

  constructor(name: string) {
    if (strings.TrimSpace(name) == "") {
      throw errors.New("suite name must not be empty");
    }
    if (!utf8.ValidString(name)) {
      throw errors.New("suite name must be valid UTF-8");
    }
    this.name = name;
    this.cases = [];
    this.before = nil;
    this.after = nil;
    this.beforeContext = nil;
    this.afterContext = nil;
    this.beforeSuite = nil;
    this.beforeSuiteContext = nil;
    this.afterSuite = nil;
  }

  public function beforeAll(body: () => void): void {
    if (body == nil) {
      throw errors.New("beforeAll body must not be nil");
    }
    this.beforeSuite = body;
    this.beforeSuiteContext = nil;
  }

  public function beforeAllWithContext(body: (context: TestContext) => void): void {
    if (body == nil) {
      throw errors.New("beforeAllWithContext body must not be nil");
    }
    this.beforeSuiteContext = body;
    this.beforeSuite = nil;
  }

  public function afterAll(body: () => void): void {
    if (body == nil) {
      throw errors.New("afterAll body must not be nil");
    }
    this.afterSuite = body;
  }

  public function beforeEach(body: () => void): void {
    if (body == nil) {
      throw errors.New("beforeEach body must not be nil");
    }
    this.before = body;
    this.beforeContext = nil;
  }

  public function beforeEachWithContext(body: (context: TestContext) => void): void {
    if (body == nil) {
      throw errors.New("beforeEachWithContext body must not be nil");
    }
    this.beforeContext = body;
    this.before = nil;
  }

  public function afterEach(body: () => void): void {
    if (body == nil) {
      throw errors.New("afterEach body must not be nil");
    }
    this.after = body;
    this.afterContext = nil;
  }

  public function afterEachWithContext(body: (context: TestContext) => void): void {
    if (body == nil) {
      throw errors.New("afterEachWithContext body must not be nil");
    }
    this.afterContext = body;
    this.after = nil;
  }

  public function test(name: string, body: () => void): void {
    this.addCase(name, body, nil, nil, "run");
  }

  public function testWithContext(name: string, body: (context: TestContext) => void): void {
    if (body == nil) {
      throw errors.New("testWithContext body must not be nil");
    }
    this.addCase(name, nil, body, nil, "run");
  }

  public function testWithFixture<T>(name: string, setup: (context: TestContext) => T, body: (value: T, context: TestContext) => void): void {
    if (setup == nil) {
      throw errors.New("testWithFixture setup must not be nil");
    }
    if (body == nil) {
      throw errors.New("testWithFixture body must not be nil");
    }
    this.addCase(name, nil, nil, (context: TestContext): FixtureInvocation => {
      const value = setup(context);
      return FixtureInvocation { body: (): void => { body(value, context); } };
    }, "run");
  }

  public function skip(name: string, body: () => void): void {
    this.addCase(name, body, nil, nil, "skip");
  }

  public function todo(name: string): void {
    this.addCase(name, nil, nil, nil, "todo");
  }

  public function skipEach<T>(values: T[], nameOf: (value: T) => string, body: (value: T) => void): void {
    if (nameOf == nil) {
      throw errors.New("skipEach name callback must not be nil");
    }
    if (body == nil) {
      throw errors.New("skipEach body must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("skipEach requires at least one value");
    }
    const names = this.tableNames<T>(values, nameOf);
    let index = 0;
    for (const value of values) {
      const caseValue = value;
      this.skip(names[index], (): void => { body(caseValue); });
      index++;
    }
  }

  public function todoEach<T>(values: T[], nameOf: (value: T) => string): void {
    if (nameOf == nil) {
      throw errors.New("todoEach name callback must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("todoEach requires at least one value");
    }
    const names = this.tableNames<T>(values, nameOf);
    for (const name of names) {
      this.todo(name);
    }
  }

  public function skipEachIndexed<T>(values: T[], nameOf: (value: T, index: int) => string, body: (value: T, index: int) => void): void {
    if (nameOf == nil) {
      throw errors.New("skipEachIndexed name callback must not be nil");
    }
    if (body == nil) {
      throw errors.New("skipEachIndexed body must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("skipEachIndexed requires at least one value");
    }
    this.skipEach<IndexedTestRow<T>>(indexedTestRows<T>(values), (row: IndexedTestRow<T>): string => {
      return nameOf(row.value, row.index);
    }, (row: IndexedTestRow<T>): void => { body(row.value, row.index); });
  }

  public function todoEachIndexed<T>(values: T[], nameOf: (value: T, index: int) => string): void {
    if (nameOf == nil) {
      throw errors.New("todoEachIndexed name callback must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("todoEachIndexed requires at least one value");
    }
    this.todoEach<IndexedTestRow<T>>(indexedTestRows<T>(values), (row: IndexedTestRow<T>): string => {
      return nameOf(row.value, row.index);
    });
  }

  private function addCase(name: string, body: () => void, contextBody: (context: TestContext) => void, fixtureBody: (context: TestContext) => FixtureInvocation, kind: string): void {
    if (strings.TrimSpace(name) == "") {
      throw errors.New("test name must not be empty");
    }
    if (!utf8.ValidString(name)) {
      throw errors.New("test name must be valid UTF-8");
    }
    if (kind == "run" && body == nil && contextBody == nil && fixtureBody == nil) {
      throw errors.New("test body must not be nil");
    }
    if (kind == "skip" && body == nil) {
      throw errors.New("skip body must not be nil");
    }
    for (const existing of this.cases) {
      if (existing.name == name) {
        throw fmt.Errorf("duplicate test name %q", name);
      }
    }
    this.cases = append(this.cases, TestCase { name: name, body: body, contextBody: contextBody, fixtureBody: fixtureBody, kind: kind });
  }

  public function testEach<T>(values: T[], nameOf: (value: T) => string, body: (value: T) => void): void {
    if (nameOf == nil) {
      throw errors.New("testEach name callback must not be nil");
    }
    if (body == nil) {
      throw errors.New("testEach body must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("testEach requires at least one value");
    }
    const names = this.tableNames(values, nameOf);
    let index = 0;
    for (const value of values) {
      const name = names[index];
      const caseValue = value;
      this.test(name, (): void => {
        body(caseValue);
      });
      index++;
    }
  }

  public function testEachWithContext<T>(values: T[], nameOf: (value: T) => string, body: (value: T, context: TestContext) => void): void {
    if (nameOf == nil) {
      throw errors.New("testEachWithContext name callback must not be nil");
    }
    if (body == nil) {
      throw errors.New("testEachWithContext body must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("testEachWithContext requires at least one value");
    }
    const names = this.tableNames(values, nameOf);
    let index = 0;
    for (const value of values) {
      const name = names[index];
      const caseValue = value;
      this.testWithContext(name, (context: TestContext): void => {
        body(caseValue, context);
      });
      index++;
    }
  }

  public function testEachWithFixture<T, F>(values: T[], nameOf: (value: T) => string, setup: (value: T, context: TestContext) => F, body: (value: T, fixture: F, context: TestContext) => void): void {
    if (nameOf == nil) {
      throw errors.New("testEachWithFixture name callback must not be nil");
    }
    if (setup == nil) {
      throw errors.New("testEachWithFixture setup must not be nil");
    }
    if (body == nil) {
      throw errors.New("testEachWithFixture body must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("testEachWithFixture requires at least one value");
    }
    const names = this.tableNames(values, nameOf);
    let index = 0;
    for (const value of values) {
      const name = names[index];
      const caseValue = value;
      this.testWithFixture(name, (context: TestContext): F => {
        return setup(caseValue, context);
      }, (fixture: F, context: TestContext): void => {
        body(caseValue, fixture, context);
      });
      index++;
    }
  }

  public function testEachIndexed<T>(values: T[], nameOf: (value: T, index: int) => string, body: (value: T, index: int) => void): void {
    if (nameOf == nil) {
      throw errors.New("testEachIndexed name callback must not be nil");
    }
    if (body == nil) {
      throw errors.New("testEachIndexed body must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("testEachIndexed requires at least one value");
    }
    this.testEach<IndexedTestRow<T>>(indexedTestRows<T>(values), (row: IndexedTestRow<T>): string => {
      return nameOf(row.value, row.index);
    }, (row: IndexedTestRow<T>): void => {
      body(row.value, row.index);
    });
  }

  public function testEachIndexedWithContext<T>(values: T[], nameOf: (value: T, index: int) => string, body: (value: T, index: int, context: TestContext) => void): void {
    if (nameOf == nil) {
      throw errors.New("testEachIndexedWithContext name callback must not be nil");
    }
    if (body == nil) {
      throw errors.New("testEachIndexedWithContext body must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("testEachIndexedWithContext requires at least one value");
    }
    this.testEachWithContext<IndexedTestRow<T>>(indexedTestRows<T>(values), (row: IndexedTestRow<T>): string => {
      return nameOf(row.value, row.index);
    }, (row: IndexedTestRow<T>, context: TestContext): void => {
      body(row.value, row.index, context);
    });
  }

  public function testEachIndexedWithFixture<T, F>(values: T[], nameOf: (value: T, index: int) => string, setup: (value: T, index: int, context: TestContext) => F, body: (value: T, index: int, fixture: F, context: TestContext) => void): void {
    if (nameOf == nil) {
      throw errors.New("testEachIndexedWithFixture name callback must not be nil");
    }
    if (setup == nil) {
      throw errors.New("testEachIndexedWithFixture setup must not be nil");
    }
    if (body == nil) {
      throw errors.New("testEachIndexedWithFixture body must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("testEachIndexedWithFixture requires at least one value");
    }
    this.testEachWithFixture<IndexedTestRow<T>, F>(indexedTestRows<T>(values), (row: IndexedTestRow<T>): string => {
      return nameOf(row.value, row.index);
    }, (row: IndexedTestRow<T>, context: TestContext): F => {
      return setup(row.value, row.index, context);
    }, (row: IndexedTestRow<T>, fixture: F, context: TestContext): void => {
      body(row.value, row.index, fixture, context);
    });
  }

  private function tableNames<T>(values: T[], nameOf: (value: T) => string): string[] {
    let names: string[] = [];
    for (const value of values) {
      const name = nameOf(value);
      if (strings.TrimSpace(name) == "") {
        throw errors.New("test name must not be empty");
      }
      if (!utf8.ValidString(name)) {
        throw errors.New("test name must be valid UTF-8");
      }
      for (const existing of this.cases) {
        if (existing.name == name) {
          throw fmt.Errorf("duplicate test name %q", name);
        }
      }
      for (const staged of names) {
        if (staged == name) {
          throw fmt.Errorf("duplicate test name %q", name);
        }
      }
      names = append(names, name);
    }
    // Naming callbacks can register cases; validate the final state before
    // committing any row from this batch.
    for (const name of names) {
      for (const existing of this.cases) {
        if (existing.name == name) {
          throw fmt.Errorf("duplicate test name %q", name);
        }
      }
    }
    return names;
  }

  public function run(): Summary {
    return this.runTo(os.Stdout);
  }

  public function runAndExit(): void {
    if (!this.run().success()) {
      markFailedSuiteExit();
      os.Exit(1);
    }
  }

  public function runTo(writer: io.Writer): Summary {
    const suiteStarted = time.Now();
    let result = Summary {
      suite: this.name,
      failOnTodo: os.Getenv("VASEST_FAIL_ON_TODO") == "1",
      passed: 0,
      failed: 0,
      skipped: 0,
      todo: 0,
      durationNs: 0,
      results: [],
    };
    const filter = os.Getenv("VASEST_FILTER");
    const rerunText = os.Getenv("VASEST_RERUN_SELECTION");
    let rerun = RerunSelection { all: true, suites: [] };
    if (rerunText != "") {
      rerun = readRerunSelection(rerunText);
    }
    const bail = os.Getenv("VASEST_BAIL") == "1";
    let selected: TestCase[] = [];
    for (const testCase of this.cases) {
      if ((filter != "" && !strings.Contains(testCase.name, filter)) || !matchesRerun(rerun, this.name, testCase.name)) {
        result.skipped++;
        continue;
      }
      selected = append(selected, testCase);
    }
    const shuffleText = os.Getenv("VASEST_SHUFFLE_SEED");
    if (shuffleText != "") {
      const [seed, parseError] = strconv.ParseInt(shuffleText, 10, 64);
      if (parseError != nil || seed < 0) {
        throw fmt.Errorf("invalid shuffle seed %q", shuffleText);
      }
      const random = rand.New(rand.NewSource(seed));
      for (let index = len(selected) - 1; index > 0; index--) {
        const other = random.Intn(index + 1);
        const current = selected[index];
        selected[index] = selected[other];
        selected[other] = current;
      }
    }
    let hasRunnable = false;
    for (const testCase of selected) {
      if (testCase.kind == "run") {
        hasRunnable = true;
      }
    }
    if (len(selected) > 0) {
      const suiteCleanup = new CleanupScope();
      let beforeFailure = "";
      let beforeLocation = emptyLocation();
      let beforeFailed = false;
      let beforeSkip = "";
      let beforeDuration: int64 = 0;
      let bailed = false;
      try {
        if (hasRunnable && (this.beforeSuite != nil || this.beforeSuiteContext != nil)) {
          const beforeStarted = time.Now();
          try {
            if (this.beforeSuiteContext != nil) {
              this.beforeSuiteContext(suiteCleanup.context());
            } else {
              this.beforeSuite();
            }
          } catch (err: error) {
            beforeSkip = testSkipReason(err);
            if (beforeSkip == "") {
              beforeFailed = true;
              beforeFailure = err.Error();
              beforeLocation = failureLocation(err);
            }
          }
          beforeDuration = time.Since(beforeStarted).Nanoseconds();
        }
        if (beforeFailed) {
          result.failed++;
          const failures = [TestFailure { phase: "beforeAll", message: beforeFailure, location: beforeLocation }];
          result.results = append(result.results, failedResult("<beforeAll>", beforeFailure, beforeDuration, failures));
          fmt.Fprintf(writer, "FAIL %s / beforeAll: %s\n", this.name, beforeFailure);
          writeFailureDetails(writer, failures);
        }
        for (const testCase of selected) {
          if (filter != "" || rerunText != "") {
            recordMatch();
          }
          if (bailed) {
            result.skipped++;
            result.results = append(result.results, TestResult { name: testCase.name, passed: false, message: "not run after failure (--bail)", status: "skip", durationNs: 0, failures: [] });
            fmt.Fprintf(writer, "SKIP %s / %s: not run after failure (--bail)\n", this.name, testCase.name);
            continue;
          }
          if (testCase.kind == "skip") {
            result.skipped++;
            result.results = append(result.results, TestResult { name: testCase.name, passed: false, message: "", status: "skip", durationNs: 0, failures: [] });
            fmt.Fprintf(writer, "SKIP %s / %s\n", this.name, testCase.name);
            continue;
          }
          if (testCase.kind == "todo") {
            result.todo++;
            result.results = append(result.results, TestResult { name: testCase.name, passed: false, message: "", status: "todo", durationNs: 0, failures: [] });
            fmt.Fprintf(writer, "TODO %s / %s\n", this.name, testCase.name);
            continue;
          }
          if (beforeSkip != "") {
            result.skipped++;
            result.results = append(result.results, TestResult { name: testCase.name, passed: false, message: beforeSkip, status: "skip", durationNs: 0, failures: [] });
            fmt.Fprintf(writer, "SKIP %s / %s: %s\n", this.name, testCase.name, beforeSkip);
            continue;
          }
          if (beforeFailed) {
            result.skipped++;
            result.results = append(result.results, TestResult { name: testCase.name, passed: false, message: "beforeAll failed", status: "skip", durationNs: 0, failures: [] });
            fmt.Fprintf(writer, "SKIP %s / %s: beforeAll failed\n", this.name, testCase.name);
            continue;
          }
          let failures: TestFailure[] = [];
          let skippedReason = "";
          let phase = "beforeEach";
          const cleanupScope = new CleanupScope();
          const context = cleanupScope.context();
          const caseStarted = time.Now();
          try {
            withEnv("VASEST_SNAPSHOT_SCOPE", fmt.Sprintf("%q / %q", this.name, testCase.name), (): void => {
              try {
                try {
                  if (this.beforeContext != nil) {
                    this.beforeContext(context);
                  } else if (this.before != nil) {
                    this.before();
                  }
                  if (testCase.fixtureBody != nil) {
                    phase = "fixture";
                    const invocation = testCase.fixtureBody(context);
                    phase = "body";
                    invocation.body();
                  } else if (testCase.contextBody != nil) {
                    phase = "body";
                    testCase.contextBody(context);
                  } else {
                    phase = "body";
                    testCase.body();
                  }
                } catch (err: error) {
                  skippedReason = testSkipReason(err);
                  if (skippedReason == "") {
                    failures = append(failures, failureDetail(phase, err));
                  }
                }
              } finally {
                try {
                  try {
                    if (this.afterContext != nil) {
                      this.afterContext(context);
                    } else if (this.after != nil) {
                      this.after();
                    }
                  } catch (err: error) {
                    failures = append(failures, failureDetail("afterEach", err));
                  }
                } finally {
                  const cleanupFailures = cleanupScope.drain();
                  for (const failure of cleanupFailures) {
                    failures = append(failures, failure);
                  }
                }
              }
            });
          } catch (err: error) {
            failures = append(failures, failureDetail("fixture", err));
          }
          const caseDuration = time.Since(caseStarted).Nanoseconds();
          if (len(failures) == 0) {
            if (skippedReason != "") {
              result.skipped++;
              result.results = append(result.results, TestResult { name: testCase.name, passed: false, message: skippedReason, status: "skip", durationNs: caseDuration, failures: [] });
              fmt.Fprintf(writer, "SKIP %s / %s: %s\n", this.name, testCase.name, skippedReason);
            } else {
              result.passed++;
              result.results = append(result.results, TestResult { name: testCase.name, passed: true, message: "", status: "pass", durationNs: caseDuration, failures: [] });
              fmt.Fprintf(writer, "PASS %s / %s\n", this.name, testCase.name);
            }
          } else {
            result.failed++;
            const failure = failureMessage(failures);
            result.results = append(result.results, failedResult(testCase.name, failure, caseDuration, failures));
            fmt.Fprintf(writer, "FAIL %s / %s: %s\n", this.name, testCase.name, failure);
            writeFailureDetails(writer, failures);
            if (bail) {
              bailed = true;
            }
          }
        }
      } finally {
        if (hasRunnable) {
          const afterStarted = time.Now();
          let failures: TestFailure[] = [];
          try {
            try {
              if (this.afterSuite != nil) {
                this.afterSuite();
              }
            } catch (err: error) {
              failures = append(failures, failureDetail("afterAll", err));
            }
          } finally {
            const cleanupFailures = suiteCleanup.drain();
            for (const failure of cleanupFailures) {
              failures = append(failures, failure);
            }
          }
          if (len(failures) > 0) {
            result.failed++;
            const message = failureMessage(failures);
            result.results = append(result.results, failedResult("<afterAll>", message, time.Since(afterStarted).Nanoseconds(), failures));
            fmt.Fprintf(writer, "FAIL %s / afterAll: %s\n", this.name, message);
            writeFailureDetails(writer, failures);
          }
        }
      }
    }
    if (len(this.cases) == 0) {
      fmt.Fprintf(writer, "FAIL %s: no tests registered\n", this.name);
    } else if (len(selected) == 0) {
      if (rerunText != "") {
        fmt.Fprintf(writer, "SKIP %s: no tests match failure history and filter\n", this.name);
      } else {
        fmt.Fprintf(writer, "SKIP %s: no tests match %q\n", this.name, filter);
      }
    }
    result.durationNs = time.Since(suiteStarted).Nanoseconds();
    fmt.Fprintf(writer, "%d passed, %d failed, %d skipped, %d todo\n", result.passed, result.failed, result.skipped, result.todo);
    if (result.failOnTodo && result.todo > 0) {
      fmt.Fprintf(writer, "FAIL %s: todo tests are not allowed (--fail-on-todo)\n", this.name);
    }
    writeReport(result);
    return result;
  }
}

struct FixtureValue<T> {
  value: T;
  ready: boolean;
}

class SharedFixtureValue<T> {
  public result: FixtureValue<T>;

  constructor() {
    this.result.ready = false;
  }
}

export class FixtureSuite<T> {
  private suite: Suite;
  private state: SharedFixtureValue<T>;
  private beforeSuite: (fixture: T) => void;
  private afterSuite: (fixture: T) => void;
  private running: boolean;

  constructor(name: string, setup: (context: TestContext) => T) {
    if (setup == nil) {
      throw errors.New("fixture suite setup must not be nil");
    }
    this.suite = new Suite(name);
    this.state = new SharedFixtureValue<T>();
    this.beforeSuite = nil;
    this.afterSuite = nil;
    this.running = false;
    this.suite.beforeAllWithContext((context: TestContext): void => {
      // Clear the retained value after all user/resource cleanup, including
      // setup failures and native panics. Each run prepares a fresh value.
      context.cleanup((): void => {
        this.state = new SharedFixtureValue<T>();
      });
      const value = setup(context);
      this.state.result.value = value;
      this.state.result.ready = true;
      if (this.beforeSuite != nil) {
        this.beforeSuite(value);
      }
    });
    this.suite.afterAll((): void => {
      if (this.state.result.ready && this.afterSuite != nil) {
        this.afterSuite(this.state.result.value);
      }
    });
  }

  public function beforeAll(body: (fixture: T) => void): void {
    if (body == nil) {
      throw errors.New("beforeAll body must not be nil");
    }
    this.beforeSuite = body;
  }

  public function afterAll(body: (fixture: T) => void): void {
    if (body == nil) {
      throw errors.New("afterAll body must not be nil");
    }
    this.afterSuite = body;
  }

  public function beforeEach(body: (fixture: T) => void): void {
    if (body == nil) {
      throw errors.New("beforeEach body must not be nil");
    }
    this.suite.beforeEach((): void => { body(this.state.result.value); });
  }

  public function beforeEachWithContext(body: (fixture: T, context: TestContext) => void): void {
    if (body == nil) {
      throw errors.New("beforeEachWithContext body must not be nil");
    }
    this.suite.beforeEachWithContext((context: TestContext): void => { body(this.state.result.value, context); });
  }

  public function afterEach(body: (fixture: T) => void): void {
    if (body == nil) {
      throw errors.New("afterEach body must not be nil");
    }
    this.suite.afterEach((): void => { body(this.state.result.value); });
  }

  public function afterEachWithContext(body: (fixture: T, context: TestContext) => void): void {
    if (body == nil) {
      throw errors.New("afterEachWithContext body must not be nil");
    }
    this.suite.afterEachWithContext((context: TestContext): void => { body(this.state.result.value, context); });
  }

  public function test(name: string, body: (fixture: T, context: TestContext) => void): void {
    if (body == nil) {
      throw errors.New("test body must not be nil");
    }
    this.suite.testWithContext(name, (context: TestContext): void => {
      body(this.state.result.value, context);
    });
  }

  public function testEach<R>(values: R[], nameOf: (value: R) => string, body: (value: R, fixture: T, context: TestContext) => void): void {
    if (nameOf == nil) {
      throw errors.New("testEach name callback must not be nil");
    }
    if (body == nil) {
      throw errors.New("testEach body must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("testEach requires at least one value");
    }
    this.suite.testEachWithContext(values, nameOf, (value: R, context: TestContext): void => {
      body(value, this.state.result.value, context);
    });
  }

  public function testEachIndexed<R>(values: R[], nameOf: (value: R, index: int) => string, body: (value: R, index: int, fixture: T, context: TestContext) => void): void {
    if (nameOf == nil) {
      throw errors.New("testEachIndexed name callback must not be nil");
    }
    if (body == nil) {
      throw errors.New("testEachIndexed body must not be nil");
    }
    if (len(values) == 0) {
      throw errors.New("testEachIndexed requires at least one value");
    }
    this.suite.testEachIndexedWithContext<R>(values, nameOf, (value: R, index: int, context: TestContext): void => {
      body(value, index, this.state.result.value, context);
    });
  }

  public function skip(name: string, body: (fixture: T, context: TestContext) => void): void {
    if (body == nil) {
      throw errors.New("skip body must not be nil");
    }
    this.suite.skip(name, (): void => {});
  }

  public function todo(name: string): void {
    this.suite.todo(name);
  }

  public function skipEach<R>(values: R[], nameOf: (value: R) => string, body: (value: R, fixture: T, context: TestContext) => void): void {
    if (nameOf == nil) {
      throw errors.New("skipEach name callback must not be nil");
    }
    if (body == nil) {
      throw errors.New("skipEach body must not be nil");
    }
    this.suite.skipEach<R>(values, nameOf, (value: R): void => {});
  }

  public function todoEach<R>(values: R[], nameOf: (value: R) => string): void {
    this.suite.todoEach<R>(values, nameOf);
  }

  public function skipEachIndexed<R>(values: R[], nameOf: (value: R, index: int) => string, body: (value: R, index: int, fixture: T, context: TestContext) => void): void {
    if (nameOf == nil) {
      throw errors.New("skipEachIndexed name callback must not be nil");
    }
    if (body == nil) {
      throw errors.New("skipEachIndexed body must not be nil");
    }
    this.suite.skipEachIndexed<R>(values, nameOf, (value: R, index: int): void => {});
  }

  public function todoEachIndexed<R>(values: R[], nameOf: (value: R, index: int) => string): void {
    this.suite.todoEachIndexed<R>(values, nameOf);
  }

  public function run(): Summary {
    return this.runTo(os.Stdout);
  }

  public function runAndExit(): void {
    if (!this.run().success()) {
      markFailedSuiteExit();
      os.Exit(1);
    }
  }

  public function runTo(writer: io.Writer): Summary {
    if (this.running) {
      throw errors.New("fixture suite is already running");
    }
    this.running = true;
    try {
      return this.suite.runTo(writer);
    } finally {
      this.running = false;
    }
  }
}

function writeReport(summary: Summary): void {
  const path = os.Getenv("VASEST_REPORT_PATH");
  if (path == "") {
    return;
  }
  const [encoded, encodeError] = json.Marshal(summary);
  if (encodeError != nil) {
    throw fmt.Errorf("cannot encode test report: %w", encodeError);
  }
  const [file, openError] = os.OpenFile(path, os.O_APPEND | os.O_WRONLY, 0600);
  if (openError != nil) {
    throw fmt.Errorf("cannot open test report: %w", openError);
  }
  const [written, writeError] = fmt.Fprintf(file, "{\"success\":%t,\"summary\":%s}\n", summary.success(), string(encoded));
  const closeError = file.Close();
  if (writeError != nil) {
    throw fmt.Errorf("cannot write test report: %w", writeError);
  }
  if (closeError != nil) {
    throw fmt.Errorf("cannot close test report: %w", closeError);
  }
}

export function runSuiteAndExit(name: string, register: (suite: Suite) => void): void {
  if (register == nil) {
    throw errors.New("suite registration body must not be nil");
  }
  const suite = new Suite(name);
  register(suite);
  suite.runAndExit();
}

export function withTempDir(body: (path: string) => void): void {
  if (body == nil) {
    throw errors.New("withTempDir body must not be nil");
  }
  const [path, createError] = os.MkdirTemp("", "vasest-*");
  if (createError != nil) {
    throw createError;
  }
  let bodyFailed = false;
  let bodyError: error = nil;
  let cleanupError: error = nil;
  try {
    try {
      body(path);
    } catch (err: error) {
      bodyFailed = true;
      bodyError = err;
    }
  } finally {
    cleanupError = os.RemoveAll(path);
  }
  if (cleanupError != nil) {
    if (bodyFailed) {
      throw fmt.Errorf("%v; temporary directory cleanup failed: %w", bodyError, cleanupError);
    }
    throw fmt.Errorf("temporary directory cleanup failed: %w", cleanupError);
  }
  if (bodyFailed) {
    throw bodyError;
  }
}

export function withEnv(name: string, value: string, body: () => void): void {
  if (body == nil) {
    throw errors.New("withEnv body must not be nil");
  }
  const [previous, existed] = os.LookupEnv(name);
  const setError = os.Setenv(name, value);
  if (setError != nil) {
    throw fmt.Errorf("cannot set environment variable %q: %w", name, setError);
  }
  let bodyFailed = false;
  let bodyError: error = nil;
  let restoreError: error = nil;
  try {
    try {
      body();
    } catch (err: error) {
      bodyFailed = true;
      bodyError = err;
    }
  } finally {
    if (existed) {
      restoreError = os.Setenv(name, previous);
    } else {
      restoreError = os.Unsetenv(name);
    }
  }
  if (restoreError != nil) {
    if (bodyFailed) {
      throw fmt.Errorf("%v; environment variable %q restore failed: %w", bodyError, name, restoreError);
    }
    throw fmt.Errorf("environment variable %q restore failed: %w", name, restoreError);
  }
  if (bodyFailed) {
    throw bodyError;
  }
}

function recordMatch(): void {
  const path = os.Getenv("VASEST_MATCH_LOG");
  if (path == "") {
    return;
  }
  const [file, openError] = os.OpenFile(path, os.O_APPEND | os.O_WRONLY, 0600);
  if (openError != nil) {
    throw openError;
  }
  const [written, writeError] = file.WriteString("1\n");
  const closeError = file.Close();
  if (writeError != nil) {
    throw writeError;
  }
  if (closeError != nil) {
    throw closeError;
  }
}

function markFailedSuiteExit(): void {
  const path = os.Getenv("VASEST_SUITE_EXIT_PATH");
  if (path != "") {
    const writeError = os.WriteFile(path, bytes.NewBufferString("1\n").Bytes(), 0600);
    if (writeError != nil) {
      throw fmt.Errorf("cannot record suite exit: %w", writeError);
    }
  }
}

export function fail(message: string): void {
  if (message == "") {
    throw assertionError(errors.New("test failed"));
  }
  throw assertionError(errors.New(message));
}

export function waitFor(body: () => void, timeout: time.Duration, interval: time.Duration): void {
  if (body == nil) {
    throw assertionError(errors.New("waitFor body must not be nil"));
  }
  if (timeout <= 0) {
    throw assertionError(errors.New("waitFor timeout must be positive"));
  }
  if (interval <= 0) {
    throw assertionError(errors.New("waitFor interval must be positive"));
  }
  const location = callerLocation();
  const deadline = time.Now().Add(timeout);
  let attempts = 0;
  for (;;) {
    attempts++;
    try {
      body();
      return;
    } catch (err: error) {
      waitForNextAttempt(err, deadline, timeout, interval, attempts, "waitFor", location);
    }
  }
}

export function waitForValue<T>(read: () => T, predicate: (value: T) => boolean, timeout: time.Duration, interval: time.Duration): T {
  const location = callerLocation();
  if (read == nil) {
    throw new FailureError(errors.New("waitForValue read must not be nil"), location);
  }
  if (predicate == nil) {
    throw new FailureError(errors.New("waitForValue predicate must not be nil"), location);
  }
  if (timeout <= 0) {
    throw new FailureError(errors.New("waitForValue timeout must be positive"), location);
  }
  if (interval <= 0) {
    throw new FailureError(errors.New("waitForValue interval must be positive"), location);
  }
  const deadline = time.Now().Add(timeout);
  let attempts = 0;
  for (;;) {
    attempts++;
    try {
      const value = read();
      if (predicate(value)) {
        return value;
      }
      throw new FailureError(errors.New("waitForValue predicate returned false"), location);
    } catch (err: error) {
      waitForNextAttempt(err, deadline, timeout, interval, attempts, "waitForValue", location);
    }
  }
  // The source checker does not prove that this infinite loop cannot fall through.
  throw errors.New("unreachable waitForValue loop");
}

function waitForNextAttempt(err: error, deadline: time.Time, timeout: time.Duration, interval: time.Duration, attempts: int, name: string, location: TestLocation): void {
  if (testSkipReason(err) != "") {
    throw err;
  }
  const remaining = time.Until(deadline);
  if (remaining <= 0) {
    throwWaitForTimeout(err, timeout, attempts, name, location);
  }
  let pause = interval;
  if (pause > remaining) {
    pause = remaining;
  }
  time.Sleep(pause);
  if (time.Until(deadline) <= 0) {
    throwWaitForTimeout(err, timeout, attempts, name, location);
  }
}

function throwWaitForTimeout(err: error, timeout: time.Duration, attempts: int, name: string, location: TestLocation): void {
  const timedOut = fmt.Errorf("%s timed out after %s (%d attempts): %w", name, timeout.String(), attempts, err);
  if (failureLocation(err).source != "") {
    throw timedOut;
  }
  throw new FailureError(timedOut, location);
}

export function expectApprox(actual: float64, expected: float64, tolerance: float64): void {
  if (math.IsNaN(tolerance) || math.IsInf(tolerance, 0) || tolerance < 0) {
    throw assertionError(errors.New("tolerance must be finite and non-negative"));
  }
  if (math.IsNaN(actual) || math.IsInf(actual, 0) || math.IsNaN(expected) || math.IsInf(expected, 0)) {
    throw assertionError(errors.New("expectApprox requires finite values"));
  }
  const difference = math.Abs(actual - expected);
  if (difference > tolerance) {
    throw assertionError(fmt.Errorf("expected %g to be within %g of %g (difference %g)", actual, tolerance, expected, difference));
  }
}

export function expectSnapshot(name: string, value: string): void {
  if (strings.TrimSpace(name) == "") {
    throw assertionError(errors.New("snapshot name must not be empty"));
  }
  const testFile = os.Getenv("VASEST_TEST_FILE");
  if (testFile == "") {
    throw assertionError(errors.New("expectSnapshot requires the Vasest runner"));
  }
  const scope = os.Getenv("VASEST_SNAPSHOT_SCOPE");
  let key = name;
  let header = fmt.Sprintf("# %q\n", name);
  if (scope != "") {
    key = scope + "\n" + name;
    header = fmt.Sprintf("# %s / %q\n", scope, name);
  }
  const digest = sha256.Sum256(bytes.NewBufferString(key).Bytes());
  const directory = filepath.Join(filepath.Dir(testFile), "__snapshots__", filepath.Base(testFile));
  const path = filepath.Join(directory, fmt.Sprintf("%x.snap", digest));
  const contents = header + value;
  const [saved, readError] = os.ReadFile(path);
  if (readError == nil && string(saved) == contents) {
    return;
  }
  if (readError != nil && !os.IsNotExist(readError)) {
    throw assertionError(fmt.Errorf("cannot read snapshot %q: %w", name, readError));
  }
  if (os.Getenv("VASEST_UPDATE_SNAPSHOTS") != "1") {
    if (readError != nil) {
      throw assertionError(fmt.Errorf("snapshot %q is missing at %s; rerun with --update-snapshots", name, path));
    }
    throw assertionError(fmt.Errorf("snapshot %q mismatch: %s; rerun with --update-snapshots", name, firstTextDifference(strings.TrimPrefix(string(saved), header), value)));
  }
  const mkdirError = os.MkdirAll(directory, 0755);
  if (mkdirError != nil) {
    throw assertionError(fmt.Errorf("cannot create snapshot directory: %w", mkdirError));
  }
  const [temporary, createError] = os.CreateTemp(directory, ".vasest-snapshot-*");
  if (createError != nil) {
    throw assertionError(fmt.Errorf("cannot create snapshot: %w", createError));
  }
  const temporaryPath = temporary.Name();
  defer os.Remove(temporaryPath);
  const [written, writeError] = temporary.WriteString(contents);
  const closeError = temporary.Close();
  if (writeError != nil) {
    throw assertionError(fmt.Errorf("cannot write snapshot: %w", writeError));
  }
  if (closeError != nil) {
    throw assertionError(fmt.Errorf("cannot close snapshot: %w", closeError));
  }
  const modeError = os.Chmod(temporaryPath, 0644);
  if (modeError != nil) {
    throw assertionError(fmt.Errorf("cannot set snapshot permissions: %w", modeError));
  }
  const renameError = os.Rename(temporaryPath, path);
  if (renameError != nil) {
    throw assertionError(fmt.Errorf("cannot update snapshot %q: %w", name, renameError));
  }
}

export function expectJSONSnapshot<T>(name: string, value: T): void {
  if (strings.TrimSpace(name) == "") {
    throw assertionError(errors.New("snapshot name must not be empty"));
  }
  const [encoded, encodeError] = json.MarshalIndent(value, "", "  ");
  if (encodeError != nil) {
    throw assertionError(fmt.Errorf("cannot encode snapshot %q: %w", name, encodeError));
  }
  const location = callerLocation();
  try {
    expectSnapshot(name, string(encoded) + "\n");
  } catch (err: error) {
    throw new FailureError(err, location);
  }
}

export class NegatedExpectation<T> {
  private actual: T;

  constructor(actual: T) {
    this.actual = actual;
  }

  public function toEqual(expected: T): void {
    const location = callerLocation();
    try {
      expectNotEqual(this.actual, expected);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toBe(expected: T): void {
    const location = callerLocation();
    try {
      checkSameValue(this.actual, expected, true);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toBeNil(): void {
    if (isNilValue(this.actual)) {
      throw assertionError(errors.New("expected a non-nil value, got nil"));
    }
  }

  public function toSatisfy(predicate: (value: T) => boolean): void {
    checkPredicate<T>(this.actual, predicate, true, callerLocation());
  }
}

export class Expectation<T> {
  private actual: T;
  public not: NegatedExpectation<T>;

  constructor(actual: T) {
    this.actual = actual;
    this.not = new NegatedExpectation<T>(actual);
  }

  public function toEqual(expected: T): void {
    const location = callerLocation();
    try {
      expectEqual(this.actual, expected);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toBe(expected: T): void {
    const location = callerLocation();
    try {
      checkSameValue(this.actual, expected, false);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toBeNil(): void {
    if (!isNilValue(this.actual)) {
      throw assertionError(fmt.Errorf("expected nil, got %#v", diagnosticArgument(this.actual)));
    }
  }

  public function toSatisfy(predicate: (value: T) => boolean): void {
    checkPredicate<T>(this.actual, predicate, false, callerLocation());
  }
}

export function expect<T>(actual: T): Expectation<T> {
  return new Expectation<T>(actual);
}

function checkPredicate<T>(actual: T, predicate: (value: T) => boolean, negated: boolean, location: TestLocation): void {
  if (predicate == nil) {
    throw new FailureError(errors.New("toSatisfy predicate must not be nil"), location);
  }
  // Call once and propagate throws, skips and native panics unchanged.
  if (predicate(actual) == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected %#v not to satisfy predicate", diagnosticArgument(actual)), location);
    }
    throw new FailureError(fmt.Errorf("expected %#v to satisfy predicate", diagnosticArgument(actual)), location);
  }
}

export class NegatedOrderedExpectation<T extends cmp.Ordered> {
  private actual: T;

  constructor(actual: T) {
    this.actual = actual;
  }

  public function toBeGreaterThan(expected: T): void {
    checkOrdered<T>(this.actual, expected, "greater than", true, callerLocation());
  }

  public function toBeGreaterThanOrEqual(expected: T): void {
    checkOrdered<T>(this.actual, expected, "greater than or equal to", true, callerLocation());
  }

  public function toBeLessThan(expected: T): void {
    checkOrdered<T>(this.actual, expected, "less than", true, callerLocation());
  }

  public function toBeLessThanOrEqual(expected: T): void {
    checkOrdered<T>(this.actual, expected, "less than or equal to", true, callerLocation());
  }
}

export class OrderedExpectation<T extends cmp.Ordered> {
  private actual: T;
  public not: NegatedOrderedExpectation<T>;

  constructor(actual: T) {
    this.actual = actual;
    this.not = new NegatedOrderedExpectation<T>(actual);
  }

  public function toBeGreaterThan(expected: T): void {
    checkOrdered<T>(this.actual, expected, "greater than", false, callerLocation());
  }

  public function toBeGreaterThanOrEqual(expected: T): void {
    checkOrdered<T>(this.actual, expected, "greater than or equal to", false, callerLocation());
  }

  public function toBeLessThan(expected: T): void {
    checkOrdered<T>(this.actual, expected, "less than", false, callerLocation());
  }

  public function toBeLessThanOrEqual(expected: T): void {
    checkOrdered<T>(this.actual, expected, "less than or equal to", false, callerLocation());
  }
}

export function expectOrdered<T extends cmp.Ordered>(actual: T): OrderedExpectation<T> {
  return new OrderedExpectation<T>(actual);
}

function checkOrdered<T extends cmp.Ordered>(actual: T, expected: T, relation: string, negated: boolean, location: TestLocation): void {
  let matches = false;
  if (relation == "greater than") {
    matches = actual > expected;
  } else if (relation == "greater than or equal to") {
    matches = actual >= expected;
  } else if (relation == "less than") {
    matches = actual < expected;
  } else {
    matches = actual <= expected;
  }
  if (matches == negated) {
    if (negated) {
      throw new FailureError(fmt.Errorf("expected %#v not to be %s %#v", diagnosticArgument(actual), relation, diagnosticArgument(expected)), location);
    }
    throw new FailureError(fmt.Errorf("expected %#v to be %s %#v", diagnosticArgument(actual), relation, diagnosticArgument(expected)), location);
  }
}

export constraint Float = ~float32 | ~float64;

export class NegatedFloatExpectation<T extends Float> {
  private actual: T;

  constructor(actual: T) {
    this.actual = actual;
  }

  public function toBeCloseTo(expected: T, tolerance: T): void {
    checkFloatApprox<T>(this.actual, expected, tolerance, true, callerLocation());
  }

  public function toBeNaN(): void {
    checkFloatProperty<T>(this.actual, "NaN", true, callerLocation());
  }

  public function toBeFinite(): void {
    checkFloatProperty<T>(this.actual, "finite", true, callerLocation());
  }
}

export class FloatExpectation<T extends Float> {
  private actual: T;
  public not: NegatedFloatExpectation<T>;

  constructor(actual: T) {
    this.actual = actual;
    this.not = new NegatedFloatExpectation<T>(actual);
  }

  public function toBeCloseTo(expected: T, tolerance: T): void {
    checkFloatApprox<T>(this.actual, expected, tolerance, false, callerLocation());
  }

  public function toBeNaN(): void {
    checkFloatProperty<T>(this.actual, "NaN", false, callerLocation());
  }

  public function toBeFinite(): void {
    checkFloatProperty<T>(this.actual, "finite", false, callerLocation());
  }
}

export function expectFloat<T extends Float>(actual: T): FloatExpectation<T> {
  return new FloatExpectation<T>(actual);
}

function checkFloatApprox<T extends Float>(actual: T, expected: T, tolerance: T, negated: boolean, location: TestLocation): void {
  if (math.IsNaN(float64(tolerance)) || math.IsInf(float64(tolerance), 0) || tolerance < 0) {
    throw new FailureError(errors.New("tolerance must be finite and non-negative"), location);
  }
  if (math.IsNaN(float64(actual)) || math.IsInf(float64(actual), 0) || math.IsNaN(float64(expected)) || math.IsInf(float64(expected), 0)) {
    throw new FailureError(errors.New("toBeCloseTo requires finite values"), location);
  }
  // Keep subtraction and its rounding in T, including float32 and nominal types.
  let difference = actual - expected;
  if (difference < 0) {
    difference = -difference;
  }
  if ((difference <= tolerance) == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected %g %sto be within %g of %g (difference %g)", actual, qualifier, tolerance, expected, difference), location);
  }
}

function checkFloatProperty<T extends Float>(actual: T, property: string, negated: boolean, location: TestLocation): void {
  let matches = math.IsNaN(float64(actual));
  if (property == "finite") {
    matches = !math.IsNaN(float64(actual)) && !math.IsInf(float64(actual), 0);
  }
  if (matches == negated) {
    let qualifier = "";
    if (negated) {
      qualifier = "not ";
    }
    throw new FailureError(fmt.Errorf("expected %g %sto be %s", actual, qualifier, property), location);
  }
}

export class NegatedStringExpectation {
  private actual: string;

  constructor(actual: string) {
    this.actual = actual;
  }

  public function toContain(fragment: string): void {
    const location = callerLocation();
    try {
      expectNotContains(this.actual, fragment);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toMatch(pattern: string): void {
    const location = callerLocation();
    try {
      expectNotMatches(this.actual, pattern);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toStartWith(prefix: string): void {
    checkStringBoundary(this.actual, prefix, true, true, callerLocation());
  }

  public function toEndWith(suffix: string): void {
    checkStringBoundary(this.actual, suffix, false, true, callerLocation());
  }

  public function toHaveLength(expected: int): void {
    const location = callerLocation();
    try {
      checkLength(len(this.actual), expected, true);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }
}

export class StringExpectation {
  private actual: string;
  public not: NegatedStringExpectation;

  constructor(actual: string) {
    this.actual = actual;
    this.not = new NegatedStringExpectation(actual);
  }

  public function toContain(fragment: string): void {
    const location = callerLocation();
    try {
      expectContains(this.actual, fragment);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toMatch(pattern: string): void {
    const location = callerLocation();
    try {
      expectMatches(this.actual, pattern);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toStartWith(prefix: string): void {
    checkStringBoundary(this.actual, prefix, true, false, callerLocation());
  }

  public function toEndWith(suffix: string): void {
    checkStringBoundary(this.actual, suffix, false, false, callerLocation());
  }

  public function toHaveLength(expected: int): void {
    const location = callerLocation();
    try {
      checkLength(len(this.actual), expected, false);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }
}

export function expectString(actual: string): StringExpectation {
  return new StringExpectation(actual);
}

function checkStringBoundary(actual: string, fragment: string, fromStart: boolean, negated: boolean, location: TestLocation): void {
  let matches = false;
  let relation = "";
  if (fromStart) {
    matches = strings.HasPrefix(actual, fragment);
    relation = "start with";
  } else {
    matches = strings.HasSuffix(actual, fragment);
    relation = "end with";
  }
  if (matches == negated) {
    let qualifier = "";
    if (negated) { qualifier = "not "; }
    throw new FailureError(fmt.Errorf("expected %q %sto %s %q", actual, qualifier, relation, fragment), location);
  }
}

export class NegatedSliceExpectation<T> {
  private actual: T[];

  constructor(actual: T[]) {
    this.actual = actual;
  }

  public function toHaveElement(index: int, expected: T): void {
    checkSliceElement<T>(this.actual, index, expected, true, callerLocation());
  }

  public function toHaveElementSatisfying(index: int, predicate: (value: T) => boolean): void {
    checkSliceElementPredicate<T>(this.actual, index, predicate, true, callerLocation());
  }

  public function toContain(expected: T): void {
    const location = callerLocation();
    try {
      checkSliceContains(this.actual, expected, true);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toHaveLength(expected: int): void {
    const location = callerLocation();
    try {
      checkLength(len(this.actual), expected, true);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toSatisfyAny(predicate: (value: T) => boolean): void {
    checkSlicePredicate<T>(this.actual, predicate, false, true, callerLocation());
  }

  public function toEqualUnordered(expected: T[]): void {
    checkSliceEqualUnordered<T>(this.actual, expected, true, callerLocation());
  }

  public function toContainAll(expected: T[]): void {
    checkSliceContainsAll<T>(this.actual, expected, true, callerLocation());
  }

  public function toStartWith(expected: T[]): void {
    checkSliceBoundary<T>(this.actual, expected, true, true, callerLocation());
  }

  public function toEndWith(expected: T[]): void {
    checkSliceBoundary<T>(this.actual, expected, false, true, callerLocation());
  }

  public function toContainSequence(expected: T[]): void {
    checkSliceSequence<T>(this.actual, expected, true, callerLocation());
  }

  public function toContainInOrder(expected: T[]): void {
    checkSliceInOrder<T>(this.actual, expected, true, callerLocation());
  }

  public function toSatisfyAll(predicate: (value: T) => boolean): void {
    checkSlicePredicate<T>(this.actual, predicate, true, true, callerLocation());
  }

  public function toSatisfyAnyIndexed(predicate: (value: T, index: int) => boolean): void {
    checkSliceIndexedPredicate<T>(this.actual, predicate, false, true, callerLocation());
  }

  public function toSatisfyAllIndexed(predicate: (value: T, index: int) => boolean): void {
    checkSliceIndexedPredicate<T>(this.actual, predicate, true, true, callerLocation());
  }
}

export class SliceExpectation<T> {
  private actual: T[];
  public not: NegatedSliceExpectation<T>;

  constructor(actual: T[]) {
    this.actual = actual;
    this.not = new NegatedSliceExpectation<T>(actual);
  }

  public function toHaveElement(index: int, expected: T): void {
    checkSliceElement<T>(this.actual, index, expected, false, callerLocation());
  }

  public function toHaveElementSatisfying(index: int, predicate: (value: T) => boolean): void {
    checkSliceElementPredicate<T>(this.actual, index, predicate, false, callerLocation());
  }

  public function toContain(expected: T): void {
    const location = callerLocation();
    try {
      checkSliceContains(this.actual, expected, false);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toHaveLength(expected: int): void {
    const location = callerLocation();
    try {
      checkLength(len(this.actual), expected, false);
    } catch (err: error) {
      throw new FailureError(err, location);
    }
  }

  public function toSatisfyAny(predicate: (value: T) => boolean): void {
    checkSlicePredicate<T>(this.actual, predicate, false, false, callerLocation());
  }

  public function toEqualUnordered(expected: T[]): void {
    checkSliceEqualUnordered<T>(this.actual, expected, false, callerLocation());
  }

  public function toContainAll(expected: T[]): void {
    checkSliceContainsAll<T>(this.actual, expected, false, callerLocation());
  }

  public function toStartWith(expected: T[]): void {
    checkSliceBoundary<T>(this.actual, expected, true, false, callerLocation());
  }

  public function toEndWith(expected: T[]): void {
    checkSliceBoundary<T>(this.actual, expected, false, false, callerLocation());
  }

  public function toContainSequence(expected: T[]): void {
    checkSliceSequence<T>(this.actual, expected, false, callerLocation());
  }

  public function toContainInOrder(expected: T[]): void {
    checkSliceInOrder<T>(this.actual, expected, false, callerLocation());
  }

  public function toSatisfyAll(predicate: (value: T) => boolean): void {
    checkSlicePredicate<T>(this.actual, predicate, true, false, callerLocation());
  }

  public function toSatisfyAnyIndexed(predicate: (value: T, index: int) => boolean): void {
    checkSliceIndexedPredicate<T>(this.actual, predicate, false, false, callerLocation());
  }

  public function toSatisfyAllIndexed(predicate: (value: T, index: int) => boolean): void {
    checkSliceIndexedPredicate<T>(this.actual, predicate, true, false, callerLocation());
