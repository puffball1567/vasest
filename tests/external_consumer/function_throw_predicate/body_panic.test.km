import { Suite, TestContext, expectFunction } from "vasest";
import go fmt from "fmt";
import go reflect from "reflect";

function main(): void {
  const suite = new Suite("function predicate body panic");
  suite.afterEach((): void => { fmt.Println("function-predicate-body-panic-afterEach"); });
  suite.afterAll((): void => { fmt.Println("function-predicate-body-panic-afterAll"); });
  suite.testWithContext("native body panic", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("function-predicate-body-panic-cleanup"); });
    expectFunction((): void => { reflect.ValueOf(42).Index(0); }).toThrowSatisfying((exception: error): boolean => { fmt.Println("unreachable-body-panic-predicate"); return true; });
  });
  suite.test("later", (): void => { fmt.Println("unreachable-body-panic-later"); });
  suite.runAndExit();
}
