import { Suite, TestContext, MockAction, expectMockOutcome, expectFunction } from "vasest";
import go errors from "errors";
import go fmt from "fmt";
import go reflect from "reflect";

function main(): void {
  const suite = new Suite("mock type predicate panic");
  suite.afterEach((): void => { fmt.Println("mock-type-predicate-panic-afterEach"); });
  suite.afterAll((): void => { fmt.Println("mock-type-predicate-panic-afterAll"); });
  suite.testWithContext("native predicate panic", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("mock-type-predicate-panic-cleanup"); });
    const mock = new MockAction<int>((value: int): void => { throw errors.New("body"); });
    expectFunction((): void => { mock.invoke(1); }).toThrow();
    expectMockOutcome(mock).not.toHaveNthThrownTypeSatisfying<error>(1, (value: error): boolean => { reflect.ValueOf(42).Index(0); return true; });
  });
  suite.test("later", (): void => { fmt.Println("unreachable-predicate-panic-later"); });
  suite.runAndExit();
}
