import { Suite, TestContext, expectMap } from "vasest";
import go fmt from "fmt";
import go net from "net";

function main(): void {
  const suite = new Suite("native map key panic");
  suite.afterEach((): void => { fmt.Println("map-predicate-key-panic-afterEach"); });
  suite.afterAll((): void => { fmt.Println("map-predicate-key-panic-afterAll"); });
  suite.testWithContext("unhashable interface key", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("map-predicate-key-panic-cleanup"); });
    const values: Map<fmt.Stringer, int> = makeMap[fmt.Stringer, int]();
    expectMap<fmt.Stringer, int>(values).not.toHaveEntrySatisfying(net.ParseIP("127.0.0.1"), (value: int): boolean => { return true; });
  });
  suite.test("later case", (): void => { fmt.Println("unreachable-map-predicate-key-panic-later"); });
  suite.runAndExit();
}
