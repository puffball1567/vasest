import { Suite, FloatExpectation, expectFloat, expect } from "vasest";
import go math from "math";
import go fmt from "fmt";

type Distance = distinct float32;

function main(): void {
  const suite = new Suite("typed float matchers");
  suite.test("explicit and inferred nominal types and constructors", (): void => {
    const matcher: FloatExpectation<Distance> = expectFloat<Distance>(Distance(1.125));
    matcher.toBeCloseTo(Distance(1), Distance(0.125));
    matcher.toBeFinite();
    matcher.not.toBeNaN();
    new FloatExpectation<Distance>(Distance(-1.125)).toBeCloseTo(Distance(-1), Distance(0.125));
    expectFloat(Distance(1.5)).not.toBeCloseTo(Distance(1), Distance(0.125));
  });
  suite.test("float32 subtraction retains its rounding", (): void => {
    const actual: float32 = 1;
    const expected: float32 = 0.1;
    const tolerance: float32 = 0.9;
    expectFloat<float32>(actual).toBeCloseTo(expected, tolerance);
    expect(float64(actual) - float64(expected) > float64(tolerance)).toBe(true);
    expectFloat(1.125).toBeCloseTo(1.0, 0.125);
    expectFloat(math.Nextafter(1.125, math.Inf(1))).not.toBeCloseTo(1.0, 0.125);
  });
  suite.test("NaN infinity signed zero and subnormals", (): void => {
    expectFloat(math.NaN()).toBeNaN();
    expectFloat(math.NaN()).not.toBeFinite();
    expectFloat<float32>(float32(math.NaN())).toBeNaN();
    expectFloat<float32>(float32(math.Inf(-1))).not.toBeFinite();
    expectFloat(math.Inf(1)).not.toBeFinite();
    expectFloat(math.Inf(-1)).not.toBeNaN();
    expectFloat(math.Copysign(0.0, -1.0)).toBeCloseTo(0.0, math.Copysign(0.0, -1.0));
    expectFloat(math.SmallestNonzeroFloat64).toBeCloseTo(0.0, math.SmallestNonzeroFloat64);
    expectFloat<float32>(float32(math.SmallestNonzeroFloat32)).toBeFinite();
    expectFloat(0.0).not.toBeNaN();
  });
  suite.test("finite subtraction overflow exceeds finite tolerance", (): void => {
    expectFloat(math.MaxFloat64).not.toBeCloseTo(-math.MaxFloat64, math.MaxFloat64);
    expectFloat<float32>(float32(math.MaxFloat32)).not.toBeCloseTo(-float32(math.MaxFloat32), float32(math.MaxFloat32));
  });
  suite.test("saved matchers retain native scalar values", (): void => {
    let value: float64 = 1;
    const matcher = expectFloat(value);
    value = math.NaN();
    matcher.toBeFinite();
    matcher.not.toBeNaN();
    matcher.toBeCloseTo(1.0, 0.0);
    expectFloat(value).toBeNaN();
  });
  suite.test("later case", (): void => { fmt.Println("float-passing-later"); });
  suite.runAndExit();
}
