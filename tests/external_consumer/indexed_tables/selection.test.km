import { Suite, FixtureSuite, TestContext, expect } from "vasest";
import go fmt from "fmt";

type UserID = distinct int64;

function main(): void {
  const rows: UserID[] = [UserID(42), UserID(42), UserID(42)];
  const suite = new Suite("indexed selection");
  suite.testEachIndexed<UserID>(rows, (value: UserID, index: int): string => { return fmt.Sprintf("plain %d", index); }, (value: UserID, index: int): void => {
    expect(value).toEqual(UserID(42)); fmt.Printf("indexed-selected-plain-%d\n", index);
  });
  suite.testEachIndexedWithContext<UserID>(rows, (value: UserID, index: int): string => { return fmt.Sprintf("context %d", index); }, (value: UserID, index: int, context: TestContext): void => {
    context.cleanup((): void => { fmt.Printf("indexed-selected-context-cleanup-%d\n", index); });
    fmt.Printf("indexed-selected-context-%d\n", index);
  });
  suite.testEachIndexedWithFixture<UserID, int>(rows, (value: UserID, index: int): string => { return fmt.Sprintf("fixture %d", index); }, (value: UserID, index: int, context: TestContext): int => {
    fmt.Printf("indexed-selected-setup-%d\n", index);
    context.cleanup((): void => { fmt.Printf("indexed-selected-fixture-cleanup-%d\n", index); });
    return index;
  }, (value: UserID, index: int, fixture: int, context: TestContext): void => {
    expect(fixture).toEqual(index); fmt.Printf("indexed-selected-fixture-%d\n", index);
  });
  suite.runAndExit();
  const shared = new FixtureSuite<string>("indexed shared selection", (context: TestContext): string => {
    context.cleanup((): void => { fmt.Println("indexed-selected-shared-cleanup"); }); return "shared";
  });
  shared.testEachIndexed<UserID>(rows, (value: UserID, index: int): string => { return fmt.Sprintf("shared %d", index); }, (value: UserID, index: int, resource: string, context: TestContext): void => {
    expect(resource).toEqual("shared"); fmt.Printf("indexed-selected-shared-%d\n", index);
  });
  shared.runAndExit();
}
