import { Suite, FixtureSuite, TestContext } from "vasest";
type UserID = distinct int64;
type OtherID = distinct int64;
function main(): void {
  const suite = new Suite("type errors");
  const rows: UserID[] = [UserID(42)];
  const nameOf: (value: UserID, index: int) => string = (value: UserID, index: int): string => { return "row"; };
  const body: (value: UserID, index: int) => void = (value: UserID, index: int): void => {};
  const fixtureBody: (value: UserID, index: int, fixture: string, context: TestContext) => void = (value: UserID, index: int, fixture: string, context: TestContext): void => {};
  suite.testEachIndexedWithFixture<UserID, string>(rows, nameOf, (value: int64, index: int, context: TestContext): string => { return "fixture"; }, fixtureBody);
}
