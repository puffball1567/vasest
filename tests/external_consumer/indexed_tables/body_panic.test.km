import { Suite, TestContext } from "vasest";
import go fmt from "fmt";
import go reflect from "reflect";
function main(): void {
  const suite = new Suite("indexed body panic");
  const rows: int[] = [42];
  suite.afterEach((): void => { fmt.Println("indexed-body-panic-afterEach"); });
  suite.afterAll((): void => { fmt.Println("indexed-body-panic-afterAll"); });
  suite.testEachIndexedWithFixture<int, int>(rows, (value: int, index: int): string => { return fmt.Sprint(index); },
    (value: int, index: int, context: TestContext): int => {
      context.cleanup((): void => { fmt.Println("indexed-body-panic-cleanup"); });
      return index;
    }, (value: int, index: int, fixture: int, context: TestContext): void => {
      reflect.ValueOf(index).Index(0); fmt.Println("unreachable-indexed-body-body");
    });
  suite.test("later", (): void => { fmt.Println("unreachable-indexed-body-later"); });
  suite.runAndExit();
}
