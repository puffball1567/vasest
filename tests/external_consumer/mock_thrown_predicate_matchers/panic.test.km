import { Suite, TestContext, MockFn, expectMockOutcome, expectFunction } from "vasest";
import go errors from "errors";
import go fmt from "fmt";
import go reflect from "reflect";

function main(): void {
  const action = new MockFn<int, int>((value: int): int => { return value; });
  action.implementOnce((value: int): int => { throw errors.New("original"); });
  expectFunction((): void => { action.invoke(42); }).toThrow();
  const suite = new Suite("mock thrown predicate native panic");
  suite.afterEach((): void => { fmt.Println("throw-predicate-panic-afterEach"); });
  suite.afterAll((): void => { fmt.Println("throw-predicate-panic-afterAll"); });
  suite.testWithContext("native predicate panic", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("throw-predicate-panic-cleanup"); });
    expectMockOutcome(action).toHaveThrownSatisfying((value: error): boolean => { reflect.ValueOf(42).Index(0); return false; });
  });
  suite.test("later case", (): void => { fmt.Println("unreachable-throw-predicate-panic-later"); });
  suite.runAndExit();
}
