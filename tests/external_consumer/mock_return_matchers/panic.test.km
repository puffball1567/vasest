import { Suite, TestContext, MockResult, MockReturnSource, expectMockReturn } from "vasest";
import go fmt from "fmt";
import go reflect from "reflect";

class PanickingSource implements MockReturnSource<int> {
  constructor() {}
  public function results(): MockResult<int>[] { reflect.ValueOf(42).Index(0); return []; }
}

function main(): void {
  const suite = new Suite("mock return source native panic");
  suite.afterEach((): void => { fmt.Println("mock-return-source-afterEach"); });
  suite.afterAll((): void => { fmt.Println("mock-return-source-afterAll"); });
  suite.testWithContext("native result source panic", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("mock-return-source-cleanup"); });
    expectMockReturn<int>(new PanickingSource()).not.toHaveLastReturnedWith(42);
  });
  suite.test("later case", (): void => { fmt.Println("unreachable-mock-return-source-later"); });
  suite.runAndExit();
}
