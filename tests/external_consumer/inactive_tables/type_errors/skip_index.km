import { Suite, FixtureSuite, TestContext } from "vasest";
function main(): void {
  const suite = new Suite("types");
  const shared = new FixtureSuite<string>("types", (context: TestContext): string => { return "value"; });
  const rows: int64[] = [int64(42)];
  suite.skipEachIndexed<int64>(rows, (value: int64, index: int): string => { return "row"; }, (value: int64, index: string): void => {});
}
