import { Suite, SliceExpectation, expectSlice, expect } from "vasest";
import go fmt from "fmt";
import go math from "math";

type UserID = distinct int64;

class Record {
  public value: int;
  constructor(value: int) { this.value = value; }
}

function main(): void {
  const suite = new Suite("typed unordered slice matchers");
  suite.test("explicit types duplicates and constructors", (): void => {
    const big = UserID(1152921504606846977);
    const actual: UserID[] = [big, UserID(42), big];
    const expected: UserID[] = [big, big, UserID(42)];
    expectSlice<UserID>(actual).toEqualUnordered(expected);
    new SliceExpectation<UserID>(actual).toEqualUnordered(expected);
    expectSlice(actual).not.toEqualUnordered([big, UserID(42), UserID(42)]);
    expect(actual[1]).toEqual(UserID(42));
    expect(expected[1]).toEqual(big);
  });
  suite.test("nil empty and unequal lengths", (): void => {
    const missing: int[] = nil;
    const empty: int[] = [];
    const otherEmpty: int[] = [];
    expectSlice<int>(missing).toEqualUnordered(missing);
    expectSlice<int>(empty).toEqualUnordered(otherEmpty);
    expectSlice<int>(missing).not.toEqualUnordered(empty);
    expectSlice<int>(empty).not.toEqualUnordered(missing);
    expectSlice<int>([1, 2]).not.toEqualUnordered([2]);
  });
  suite.test("native nested collections and objects", (): void => {
    const missing: int[] = nil;
    const empty: int[] = [];
    const nested: int[][] = [missing, empty, [1, 2], [1, 2]];
    const reversed: int[][] = [[1, 2], missing, [1, 2], empty];
    expectSlice<int[]>(nested).toEqualUnordered(reversed);
    const ordered: int[][] = [[1, 2]];
    const differentlyOrdered: int[][] = [[2, 1]];
    expectSlice<int[]>(ordered).not.toEqualUnordered(differentlyOrdered);
    const left = new Record(42);
    const right = new Record(42);
    const objects: Record[] = [nil, left, left];
    const equalObjects: Record[] = [right, right, nil];
    expectSlice<Record>(objects).toEqualUnordered(equalObjects);
    right.value = 43;
    expectSlice<Record>(objects).not.toEqualUnordered(equalObjects);
    const first: Map<string, int> = makeMap[string, int]();
    const second: Map<string, int> = makeMap[string, int]();
    first["answer"] = 42;
    second["answer"] = 42;
    const maps: Map<string, int>[] = [first, nil];
    const expectedMaps: Map<string, int>[] = [nil, second];
    expectSlice<Map<string, int>>(maps).toEqualUnordered(expectedMaps);
  });
  suite.test("saved matchers observe backing values", (): void => {
    const actual: int[] = [1, 2];
    const expected: int[] = [2, 1];
    const matcher: SliceExpectation<int> = expectSlice<int>(actual);
    matcher.toEqualUnordered(expected);
    actual[0] = 3;
    matcher.not.toEqualUnordered(expected);
    expected[1] = 3;
    matcher.toEqualUnordered(expected);
    expect(actual[0]).toEqual(3);
    expect(expected[0]).toEqual(2);
  });
  suite.test("native floating point elements", (): void => {
    const actual: float64[] = [math.Copysign(0.0, -1.0), math.Inf(1), math.Inf(-1)];
    const expected: float64[] = [math.Inf(-1), 0.0, math.Inf(1)];
    expectSlice<float64>(actual).toEqualUnordered(expected);
    const nans: float64[] = [math.NaN()];
    expectSlice<float64>(nans).not.toEqualUnordered(nans);
  });
  suite.test("later case", (): void => { fmt.Println("unordered-slice-passing-later"); });
  suite.runAndExit();
}
