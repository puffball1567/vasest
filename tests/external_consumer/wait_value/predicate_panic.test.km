import { Suite, TestContext, waitForValue, waitFor } from "vasest";
import go fmt from "fmt";
import go reflect from "reflect";
import go time from "time";
function main(): void {
  const suite = new Suite("wait native panic");
  suite.afterEach((): void => { fmt.Println("wait-predicate-panic-afterEach"); });
  suite.afterAll((): void => { fmt.Println("wait-predicate-panic-afterAll"); });
  suite.testWithContext("native panic", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("wait-predicate-panic-cleanup"); });
    waitForValue<int>((): int => { return 42; }, (value: int): boolean => { reflect.ValueOf(42).Index(0); return true; }, time.Second, time.Millisecond);
  });
  suite.test("later case", (): void => { fmt.Println("unreachable-wait-predicate-panic-later"); });
  suite.runAndExit();
}
