import { Suite, TestContext, MockFn, MockAction, MockCallSource, MockExpectation, expectMock, expect, skipTest } from "vasest";
import go fmt from "fmt";

type UserID = distinct int64;

class Record {
  public value: int;
  public note: string;
  constructor(value: int, note: string) { this.value = value; this.note = note; }
}

class Spy implements MockCallSource<UserID> {
  public reads: int;
  constructor() { this.reads = 0; }
  public function calls(): UserID[] { this.reads++; return [UserID(1), UserID(42)]; }
}

function main(): void {
  const suite = new Suite("typed mock predicate matchers");
  suite.test("explicit native types preserve queued behavior and live calls", (): void => {
    const first = UserID(1152921504606846977);
    const second = UserID(1152921504606846978);
    let invocations = 0;
    let predicates = 0;
    const mock = new MockFn<UserID, string>((value: UserID): string => { invocations++; return "default"; });
    mock.returnValueOnce("queued");
    const matches: (value: UserID) => boolean = (value: UserID): boolean => { predicates++; return value == first; };
    const matcher: MockExpectation<UserID> = expectMock<UserID>(mock);
    matcher.not.toHaveBeenCalledSatisfying(matches);
    matcher.not.toHaveBeenNthCalledSatisfying(1, matches);
    matcher.not.toHaveBeenLastCalledSatisfying(matches);
    expect(predicates).toEqual(0);
    expect(mock.invoke(first)).toEqual("queued");
    matcher.toHaveBeenCalledSatisfying(matches);
    matcher.toHaveBeenNthCalledSatisfying(1, matches);
    matcher.toHaveBeenLastCalledSatisfying(matches);
    expect(mock.invoke(second)).toEqual("default");
    expectMock(mock).toHaveBeenCalledSatisfying(matches);
    matcher.not.toHaveBeenNthCalledSatisfying(2, matches);
    matcher.not.toHaveBeenLastCalledSatisfying(matches);
    expect(predicates).toEqual(6);
    expect(invocations).toEqual(1);
    mock.clearCalls();
    matcher.not.toHaveBeenCalledSatisfying(matches);
    expect(predicates).toEqual(6);
  });
  suite.test("typed application arguments with constructors and selective checks", (): void => {
    const original = new Record(42, "金木犀");
    const action = new MockAction<Record>((value: Record): void => {});
    action.invoke(original);
    new MockExpectation<Record>(action).toHaveBeenCalledSatisfying((value: Record): boolean => { return value.value == 42; });
    expectMock<Record>(action).toHaveBeenNthCalledSatisfying(1, (value: Record): boolean => { return value == original; });
    expectMock(action).toHaveBeenLastCalledSatisfying((value: Record): boolean => { value.value++; return value.note == "金木犀"; });
    expect(original.value).toEqual(43);
    expectMock(action).not.toHaveBeenNthCalledSatisfying(2, (value: Record): boolean => { return true; });
  });
  suite.test("nil and empty native collection arguments remain distinct", (): void => {
    const action = new MockAction<int[]>((value: int[]): void => {});
    const missing: int[] = nil;
    const empty: int[] = [];
    action.invoke(missing);
    action.invoke(empty);
    expectMock<int[]>(action).toHaveBeenCalledSatisfying((value: int[]): boolean => { return value == nil; });
    expectMock<int[]>(action).toHaveBeenNthCalledSatisfying(2, (value: int[]): boolean => { return value != nil && len(value) == 0; });
    expectMock<int[]>(action).not.toHaveBeenLastCalledSatisfying((value: int[]): boolean => { return value == nil; });
  });
  suite.test("custom sources read exactly one snapshot per matcher", (): void => {
    const spy = new Spy();
    const source: MockCallSource<UserID> = spy;
    const matcher = new MockExpectation<UserID>(source);
    matcher.toHaveBeenCalledSatisfying((value: UserID): boolean => { return value == UserID(42); });
    matcher.toHaveBeenNthCalledSatisfying(2, (value: UserID): boolean => { return value == UserID(42); });
    matcher.toHaveBeenLastCalledSatisfying((value: UserID): boolean => { return value == UserID(42); });
    matcher.not.toHaveBeenCalledSatisfying((value: UserID): boolean => { return value < UserID(0); });
    matcher.not.toHaveBeenNthCalledSatisfying(1, (value: UserID): boolean => { return value == UserID(42); });
    matcher.not.toHaveBeenLastCalledSatisfying((value: UserID): boolean => { return value < UserID(0); });
    expect(spy.reads).toEqual(6);
  });
  suite.test("callbacks may clear and add calls while one snapshot is inspected", (): void => {
    const action = new MockAction<int>((value: int): void => {});
    action.invoke(1);
    action.invoke(2);
    let calls = 0;
    let sum = 0;
    expectMock<int>(action).not.toHaveBeenCalledSatisfying((value: int): boolean => {
      calls++;
      sum += value;
      action.clearCalls();
      action.invoke(3);
      return false;
    });
    expect(calls).toEqual(2);
    expect(sum).toEqual(3);
    expect(action.callCount()).toEqual(1);
    expectMock(action).toHaveBeenLastCalledSatisfying((value: int): boolean => { return value == 3; });
  });
  const action = new MockAction<int>((value: int): void => {});
  action.invoke(42);
  suite.testWithContext("runtime skip through negated any", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("mock-predicate-skip-cleanup"); });
    expectMock<int>(action).not.toHaveBeenCalledSatisfying((value: int): boolean => { skipTest("mock predicate resource unavailable"); return false; });
    fmt.Println("unreachable-mock-predicate-skip");
  });
  suite.testWithContext("runtime skip through positive nth", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("mock-predicate-skip-cleanup"); });
    expectMock(action).toHaveBeenNthCalledSatisfying(1, (value: int): boolean => { skipTest("mock predicate resource unavailable"); return true; });
    fmt.Println("unreachable-mock-predicate-skip");
  });
  suite.testWithContext("runtime skip through negated last", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("mock-predicate-skip-cleanup"); });
    expectMock(action).not.toHaveBeenLastCalledSatisfying((value: int): boolean => { skipTest("mock predicate resource unavailable"); return false; });
    fmt.Println("unreachable-mock-predicate-skip");
  });
  suite.test("later case", (): void => { fmt.Println("mock-predicate-passing-later"); });
  suite.runAndExit();
}
