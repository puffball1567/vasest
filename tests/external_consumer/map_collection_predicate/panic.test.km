import { Suite, TestContext, expectMap } from "vasest";
import go fmt from "fmt";
import go reflect from "reflect";

function main(): void {
  const suite = new Suite("map collection native panic");
  suite.afterEach((): void => { fmt.Println("map-collection-panic-afterEach"); });
  suite.afterAll((): void => { fmt.Println("map-collection-panic-afterAll"); });
  suite.testWithContext("native predicate panic", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("map-collection-panic-cleanup"); });
    const values: Map<string, int> = makeMap[string, int]();
    values["entry"] = 42;
    expectMap<string, int>(values).not.toSatisfyAll((key: string, value: int): boolean => {
      reflect.ValueOf(value).Index(0);
      return false;
    });
  });
  suite.test("later case", (): void => { fmt.Println("unreachable-map-collection-panic-later"); });
  suite.runAndExit();
}
