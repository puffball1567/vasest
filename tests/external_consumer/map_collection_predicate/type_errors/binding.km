import { MapExpectation, expectMap } from "vasest";
type UserID = distinct int64;
type Score = distinct int64;
function main(): void {
  const values: Map<int64, int64> = makeMap[int64, int64]();
  const nominal: Map<UserID, Score> = makeMap[UserID, Score]();
  const check: (predicate: (key: int64, value: int32) => boolean) => void = expectMap<int64, int64>(values).toSatisfyAny;
}
