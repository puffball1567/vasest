import { Suite, TestContext, expectSlice, withTestLocation } from "vasest";
import go errors from "errors";
import go fmt from "fmt";

function main(): void {
  const suite = new Suite("slice predicate failures");
  const values: int[] = [1, 2, 3];
  const empty: int[] = [];
  suite.afterEach((): void => { fmt.Println("slice-predicate-afterEach"); });
  suite.testWithContext("any mismatch", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("slice-predicate-cleanup"); });
    expectSlice<int>(values).toSatisfyAny((value: int): boolean => { return value < 0; });
  });
  suite.test("all mismatch", (): void => { expectSlice(values).toSatisfyAll((value: int): boolean => { return value < 3; }); });
  suite.test("negated any mismatch", (): void => { expectSlice(values).not.toSatisfyAny((value: int): boolean => { return value == 2; }); });
  suite.test("negated all mismatch", (): void => { expectSlice(values).not.toSatisfyAll((value: int): boolean => { return value > 0; }); });
  suite.test("nil any predicate", (): void => { expectSlice<int>(empty).toSatisfyAny(nil); });
  suite.test("negated nil any predicate", (): void => { expectSlice<int>(empty).not.toSatisfyAny(nil); });
  suite.test("nil all predicate", (): void => { expectSlice<int>(empty).toSatisfyAll(nil); });
  suite.test("negated nil all predicate", (): void => { expectSlice<int>(empty).not.toSatisfyAll(nil); });
  suite.test("thrown predicate", (): void => {
    expectSlice<int>(values).not.toSatisfyAny((value: int): boolean => { throw errors.New("predicate callback failed"); });
  });
  suite.test("explicit callback location", (): void => {
    expectSlice<int>(values).toSatisfyAll((value: int): boolean => {
      withTestLocation("domain-check.km", 42, (): void => { throw errors.New("domain predicate failed"); });
      return true;
    });
  });
  suite.test("later case", (): void => { fmt.Println("slice-predicate-failing-later"); });
  suite.runAndExit();
}
