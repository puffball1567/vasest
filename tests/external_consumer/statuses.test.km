import { Suite, expectApprox, expectMatches, expectNotContains, expectNotMatches, expectThrowsMessage, fail, runSuiteAndExit } from "vasest";
import go errors from "errors";

function main(): void {
  runSuiteAndExit("status cases", (suite: Suite): void => {
    suite.skip("disabled", (): void => {
      throw errors.New("skipped body must not run");
    });
    suite.todo("planned");
    suite.test("regex and absence", (): void => {
      expectNotContains("金木犀", "missing");
      expectMatches("金木犀", "木");
      expectNotMatches("金木犀", "^missing$");
      expectApprox(1.125, 1.0, 0.125);
      expectThrowsMessage((): void => {
        fail("explicit failure");
      }, "explicit failure");
    });
  });
}
