import { Suite, SliceExpectation, NegatedSliceExpectation, expectSlice, expect } from "vasest";
import go fmt from "fmt";
import go math from "math";

type UserID = distinct uint64;
alias Callback = () => void;

class Node {
  public value: int;
  public next: Node;
  constructor(value: int) { this.value = value; this.next = nil; }
}

function main(): void {
  const suite = new Suite("typed ordered containment");
  suite.test("native values gaps duplicates and typed bindings", (): void => {
    const large = UserID(18446744073709551615);
    const values: UserID[] = [large, UserID(41), large, UserID(42), UserID(43)];
    const required: UserID[] = [large, large, UserID(43)];
    const matcher: SliceExpectation<UserID> = expectSlice<UserID>(values);
    const check: (expected: UserID[]) => void = matcher.toContainInOrder;
    const negative: (expected: UserID[]) => void = matcher.not.toContainInOrder;
    check(required);
    negative([large, large, large]);
    new SliceExpectation<UserID>(values).toContainInOrder(required);
    new NegatedSliceExpectation<UserID>(values).toContainInOrder([UserID(43), large]);
    expectSlice(values).toContainInOrder(required);
    expect<UserID>(values[0]).toEqual(large);
    expect<UserID>(required[0]).toEqual(large);
  });
  suite.test("nil empty longer and reversed requirements", (): void => {
    const missing: int[] = nil;
    const empty: int[] = [];
    expectSlice<int>(missing).toContainInOrder(empty);
    expectSlice<int>(empty).toContainInOrder(missing);
    expectSlice<int>([1, 2, 3]).toContainInOrder(empty);
    expectSlice<int>(missing).not.toContainInOrder([1]);
    expectSlice<int>([1]).not.toContainInOrder([1, 1]);
    expectSlice<int>([1, 2, 1]).toContainInOrder([1, 1]);
    expectSlice<int>([1, 2, 3]).not.toContainInOrder([3, 1]);
    expectSlice<int>([1, 2, 3, 1, 2, 3]).toContainInOrder([2, 1, 3]);
  });
  suite.test("nested native values", (): void => {
    const missing: int[] = nil;
    const empty: int[] = [];
    const values: int[][] = [[42], missing, [41], empty, [1, 2], [43]];
    expectSlice<int[]>(values).toContainInOrder([missing, empty, [1, 2]]);
    expectSlice<int[]>(values).not.toContainInOrder([empty, missing]);
    expectSlice<int[]>(values).not.toContainInOrder([[2, 1]]);
    const first: Map<string, int> = makeMap[string, int]();
    const second: Map<string, int> = makeMap[string, int]();
    first["value"] = 42;
    second["value"] = 42;
    const spacer: Map<string, int> = makeMap[string, int]();
    expectSlice<Map<string, int>>([first, spacer, first]).toContainInOrder([second, second]);
  });
  suite.test("cycles functions and native float equality", (): void => {
    const first = new Node(42);
    const second = new Node(42);
    first.next = first;
    second.next = second;
    const values: Node[] = [nil, first, nil, first];
    expectSlice<Node>(values).toContainInOrder([second, second]);
    second.value = 43;
    expectSlice<Node>(values).not.toContainInOrder([second]);
    expect<Node>(first.next).toBe(first);
    const nans: float64[] = [math.NaN()];
    expectSlice<float64>(nans).not.toContainInOrder(nans);
    expectSlice<float64[]>([nans]).toContainInOrder([nans]);
    expectSlice<float64>([math.Copysign(0, -1), math.Inf(1), math.Inf(-1)]).toContainInOrder([float64(0), math.Inf(-1)]);
    const missing: Callback = nil;
    const callback: Callback = (): void => {};
    const functions: Callback[] = [callback, missing];
    const required: Callback[] = [missing];
    const nonmatching: Callback[] = [callback];
    expectSlice<Callback>(functions).toContainInOrder(required);
    expectSlice<Callback>(functions).not.toContainInOrder(nonmatching);
  });
  suite.test("saved matchers observe native backing values", (): void => {
    let values: int[] = [1, 2, 3, 4];
    const matcher = expectSlice<int>(values);
    matcher.toContainInOrder([1, 3]);
    values[2] = 9;
    matcher.not.toContainInOrder([1, 3]);
    matcher.toContainInOrder([1, 9]);
    values = [0];
    matcher.toContainInOrder([1, 9]);
  });
  suite.test("later case", (): void => { fmt.Println("slice-in-order-passing-later"); });
  suite.runAndExit();
}
