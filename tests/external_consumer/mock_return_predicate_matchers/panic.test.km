import { Suite, TestContext, MockFn, expectMockReturn } from "vasest";
import go fmt from "fmt";
import go reflect from "reflect";

function main(): void {
  const action = new MockFn<int, int>((value: int): int => { return value; });
  action.invoke(42);
  const suite = new Suite("mock return predicate native panic");
  suite.afterEach((): void => { fmt.Println("return-predicate-panic-afterEach"); });
  suite.afterAll((): void => { fmt.Println("return-predicate-panic-afterAll"); });
  suite.testWithContext("native predicate panic", (context: TestContext): void => {
    context.cleanup((): void => { fmt.Println("return-predicate-panic-cleanup"); });
    expectMockReturn<int>(action).toHaveReturnedSatisfying((value: int): boolean => { reflect.ValueOf(value).Index(0); return false; });
  });
  suite.test("later case", (): void => { fmt.Println("unreachable-return-predicate-panic-later"); });
  suite.runAndExit();
}
