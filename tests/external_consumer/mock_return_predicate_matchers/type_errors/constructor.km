import { MockFn, MockReturnExpectation, expectMockReturn } from "vasest";
type UserID = distinct int64;
function main(): void {
  const mock = new MockFn<int, UserID>((value: int): UserID => { return UserID(value); }); new MockReturnExpectation<UserID>(mock).not.toHaveNthReturnedSatisfying(1, (value: int64): boolean => { return true; });
}
